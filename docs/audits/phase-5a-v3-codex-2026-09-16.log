   950	export interface KnowledgeBlock {
   951	  /** '' quando nada foi injetado. */
   952	  text: string;
   953	  /** Os trechos que DE FATO entraram em `text`. Única fonte do evento `routing` (§4.2). */
   954	  used: RetrievedChunk[];
   955	}
   956	
   957	/**
   958	 * Monta o bloco final e diz o que entrou nele (§4.2).
   959	 * - O 1º colocado entra SEMPRE, mesmo que sozinho estoure MAX_BLOCK_CHARS. O teto governa do 2º
   960	 *   em diante. Medido: 4 das 39 seções do corpus não cabiam sob o teto de 1500 da v2, entre elas
   961	 *   o alvo de D9.2 — e a v2 injetava silenciosamente o 2º colocado no lugar do 1º.
   962	 * - `break` (não `continue`): quando o próximo não cabe, o bloco está cheio. `continue` permitiria
   963	 *   pular o 2º e aceitar o 3º, uma inversão de ordem silenciosa.
   964	 * - Corpo nunca é truncado no meio: o trecho entra inteiro ou não entra.
   965	 */
   966	export function buildKnowledgeBlock(chunks: RetrievedChunk[]): KnowledgeBlock {
   967	  if (chunks.length === 0) return { text: '', used: [] };
   968	  let text = PREAMBLE;
   969	  const used: RetrievedChunk[] = [];
   970	  for (const c of chunks) {
   971	    const piece = `\n\n[${c.headingPath}]\n${c.body}`;
   972	    if (used.length > 0 && text.length + piece.length > KNOWLEDGE_LIMITS.MAX_BLOCK_CHARS) break;
   973	    text += piece;
   974	    used.push(c);
   975	  }
   976	  return { text, used };
   977	}
