    65	async function setupHarness(): Promise<Harness> {
    66	  const testConfig: AppConfig = { port: 0, host: '127.0.0.1', clientPort: 0 };
    67	  // porta 0 -> o SO escolhe uma porta livre; startServer atual exige config.port fixo,
    68	  // então usamos uma porta alta fixa por teste para simplicidade e paralelismo seguro.
    69	  const port = 20000 + Math.floor(Math.random() * 5000);
    70	  const config: AppConfig = { port, host: '127.0.0.1', clientPort: port + 1 };
    71	
    72	  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'rodrigo-voice-test-'));
    73	  const engine = new FakeVoiceEngine();
    74	  const tts = new FakeVoiceProvider();
    75	  const audioStore = new AudioStore(tmpDir);
    76	  const sessionManager = new SessionManager(engine, tts, audioStore, createSpecialistAgents());
    77	
    78	  const server = await startServer(config, undefined, { config, sessionManager, audioStore });
    79	
    80	  return { server, baseUrl: `http://127.0.0.1:${port}`, engine, tts, audioStore, sessionManager, tmpDir };
    81	}
    82	
    83	async function teardownHarness(h: Harness): Promise<void> {
    84	  // Cada sessão criada arma um setTimeout de 10min (idle timeout) que mantém o processo
    85	  // vivo se nada o limpar — shutdownAll() encerra a sessão atual e cancela esse timer
    86	  // (é o que voiceRuntime.shutdown() já faz em produção antes de fechar o servidor HTTP).
    87	  await h.sessionManager.shutdownAll();
    88	
    89	  // server.close() por si só espera conexões abertas (ex.: SSE) fecharem sozinhas, e
    90	  // closeAllConnections() sozinho não derruba conexões keep-alive ociosas — sem as duas
    91	  // juntas, close() pode travar em teste.
    92	  const closePromise = new Promise<void>((resolve) => h.server.close(() => resolve()));
    93	  h.server.closeAllConnections();
    94	  h.server.closeIdleConnections();
    95	  await closePromise;
    96	  await fs.promises.rm(h.tmpDir, { recursive: true, force: true }).catch(() => {});
    97	}
