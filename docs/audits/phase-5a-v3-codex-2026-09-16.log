    19	/**
    20	 * Monta o runtime de voz se — e só se — o setup local (`npm run setup:voice`) já rodou.
    21	 * Ausência de qualquer peça (venv, worker script, modelos) é diagnosticada honestamente
    22	 * em PT-BR; a base da Fase 1 continua funcionando sem depender de Python (B2).
    23	 */
    24	export function createVoiceRuntime(rootDir: string): VoiceRuntime {
    25	  // Usado pela suíte de testes automatizada: garante que `npm test` nunca depende de
    26	  // Python/MLX estarem instalados ou aquecidos, mesmo que .runtime já exista na máquina
    27	  // de quem está rodando os testes (B2: "retorno à base não depende de Python").
    28	  if (process.env.RODRIGO_VOICE_DISABLE === '1') {
    29	    return {
    30	      available: false,
    31	      reason: 'Voz desabilitada explicitamente (RODRIGO_VOICE_DISABLE=1).',
    32	      shutdown: async () => {}
    33	    };
    34	  }
    35	
    36	  const venvPython = path.join(rootDir, '.runtime', '.venv', 'bin', 'python3');
    37	  const workerScript = path.join(rootDir, 'scripts', 'worker', 'worker.py');
    38	  const manifestPath = path.join(rootDir, '.runtime', 'models-manifest.json');
    39	  const hfCacheDir = path.join(rootDir, '.runtime', 'hf-cache');
    40	
    41	  if (!fs.existsSync(venvPython)) {
    42	    return {
    43	      available: false,
    44	      reason: 'Runtime de voz não configurado: rode "npm run setup:voice" primeiro (cria o ambiente Python local e baixa os modelos).',
    45	      shutdown: async () => {}
    46	    };
    47	  }
    48	  if (!fs.existsSync(workerScript)) {
    49	    return {
    50	      available: false,
    51	      reason: `Worker de voz não encontrado em ${workerScript}.`,
    52	      shutdown: async () => {}
    53	    };
    54	  }
    55	  if (!fs.existsSync(manifestPath)) {
    56	    return {
    57	      available: false,
    58	      reason: 'Modelos de voz não baixados: rode "npm run setup:voice" para materializá-los localmente.',
    59	      shutdown: async () => {}
    60	    };
    61	  }
    62	
    63	  const engine = new MlxWorkerEngine({ pythonBin: venvPython, workerScript, hfCacheDir });
    64	  const ttsProvider = selectVoiceProvider();
    65	  ExtensionRegistry.getInstance().registerVoiceProvider(ttsProvider);
    66	
    67	  const agents = createSpecialistAgents();
    68	  for (const agent of agents) {
    69	    ExtensionRegistry.getInstance().registerAgent(agent);
    70	  }
    71	
    72	  const audioStore = new AudioStore(path.join(rootDir, '.runtime', 'tmp'));
    73	  const sessionManager = new SessionManager(engine, ttsProvider, audioStore, agents);
    74	
    75	  return {
    76	    available: true,
    77	    sessionManager,
    78	    audioStore,
    79	    shutdown: async () => {
    80	      await sessionManager.shutdownAll();
    81	      await engine.shutdown();
    82	    }
    83	  };
    84	}
