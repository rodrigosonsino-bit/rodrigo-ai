    15	function buildTestWav(durationSeconds = 0.2, sampleRate = 16000): Buffer {
    16	  const totalSamples = Math.round(durationSeconds * sampleRate);
    17	  const dataSize = totalSamples * 2;
    18	  const buffer = Buffer.alloc(44 + dataSize);
    19	
    20	  buffer.write('RIFF', 0, 'ascii');
    21	  buffer.writeUInt32LE(36 + dataSize, 4);
    22	  buffer.write('WAVE', 8, 'ascii');
    23	  buffer.write('fmt ', 12, 'ascii');
    24	  buffer.writeUInt32LE(16, 16);
    25	  buffer.writeUInt16LE(1, 20);
    26	  buffer.writeUInt16LE(1, 22);
    27	  buffer.writeUInt32LE(sampleRate, 24);
    28	  buffer.writeUInt32LE(sampleRate * 2, 28);
    29	  buffer.writeUInt16LE(2, 32);
    30	  buffer.writeUInt16LE(16, 34);
    31	  buffer.write('data', 36, 'ascii');
    32	  buffer.writeUInt32LE(dataSize, 40);
    33	  // amostras zeradas (silêncio) bastam para os testes de protocolo
    34	  return buffer;
    35	}
