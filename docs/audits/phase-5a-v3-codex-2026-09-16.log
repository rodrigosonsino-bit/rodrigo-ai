   590	### 6.2 `src/backend/knowledge/corpus.ts`
   591	
   592	Inalterado em relação à v2 (o achado 12 da v1 foi dado como RESOLVIDO na auditoria da v2 e a v3 não
   593	o toca).
   594	
   595	```ts
   596	import fs from 'node:fs';
   597	import path from 'node:path';
   598	import { KNOWLEDGE_LIMITS } from '../../shared/voiceProtocol.js';
   599	
   600	export interface KnowledgeChunk {
   601	  agentId: string;
   602	  headingPath: string;
   603	  body: string;
   604	}
   605	
   606	const SOURCES: ReadonlyArray<{ agentId: string; file: string }> = [
   607	  { agentId: 'teologia', file: 'teologia-profile-source.md' },
   608	  { agentId: 'virtologia', file: 'virtologia-profile-source.md' }
   609	];
   610	
   611	/**
   612	 * Segmenta markdown por cabeçalho de nível 2 e 3.
   613	 * Ignora linhas dentro de bloco cercado por ``` e aceita cabeçalho atx fechado
   614	 * ("## Título ##") sem capturar os # finais no headingPath.
   615	 */
   616	export function chunkMarkdown(agentId: string, markdown: string): KnowledgeChunk[] {
   617	  const lines = markdown.split('\n');
   618	  const chunks: KnowledgeChunk[] = [];
   619	  let currentH2 = '';
   620	  let currentHeading: string | null = null;
   621	  let buffer: string[] = [];
   622	  let inFence = false;
   623	
   624	  function flush(): void {
   625	    if (currentHeading === null) { buffer = []; return; }
   626	    const body = buffer.join('\n').trim();
   627	    buffer = [];
   628	    if (body.length < KNOWLEDGE_LIMITS.MIN_CHUNK_CHARS) return;
   629	    chunks.push({ agentId, headingPath: currentHeading, body });
   630	  }
   631	
   632	  for (const line of lines) {
   633	    if (line.trimStart().startsWith('```')) {
   634	      inFence = !inFence;
   635	      if (currentHeading !== null) buffer.push(line);
   636	      continue;
   637	    }
   638	    if (!inFence) {
   639	      const h3 = /^###\s+(.+?)(?:\s+#+)?\s*$/.exec(line);
   640	      if (h3) {
   641	        flush();
   642	        currentHeading = currentH2 ? `${currentH2} > ${h3[1]}` : h3[1];
   643	        continue;
   644	      }
   645	      const h2 = /^##\s+(.+?)(?:\s+#+)?\s*$/.exec(line);
   646	      if (h2) { flush(); currentH2 = h2[1]; currentHeading = currentH2; continue; }
   647	    }
   648	    if (currentHeading !== null) buffer.push(line);
   649	  }
   650	  flush();
   651	  return chunks;
   652	}
   653	
   654	/** Ausência de arquivo não é erro: devolve o que conseguiu ler. Corpus vazio => módulo indisponível. */
   655	export function loadKnowledgeCorpus(rootDir: string): KnowledgeChunk[] {
   656	  const dir = path.join(rootDir, 'docs', 'research');
   657	  const all: KnowledgeChunk[] = [];
   658	  for (const { agentId, file } of SOURCES) {
   659	    let text: string;
   660	    try {
   661	      text = fs.readFileSync(path.join(dir, file), 'utf8');
   662	    } catch {
   663	      continue;
   664	    }
   665	    all.push(...chunkMarkdown(agentId, text));
   666	  }
   667	  return all;
   668	}
   669	```
   670	
   671	> **Nota sobre a ordem `h3` antes de `h2`, e por que ela é cosmética.** Verificado por execução das
   672	> duas regex isoladamente: `/^##\s+(.+?)(?:\s+#+)?\s*$/` **não** casa `### Sub`, porque depois de
   673	> `##` o `\s+` teria que casar um `#`, e `#` não é espaço. Logo a ordem dos dois testes é indiferente
   674	> e o corpus sai idêntico (39 trechos) nos dois ordenamentos. Testar `h3` primeiro está aqui apenas
   675	> para que ninguém precise refazer esse raciocínio ao ler o código — **não é correção de bug**.
   676	>
   677	> Comportamento herdado e mantido: `####` e níveis mais profundos não geram trecho (a regex de `h3`
   678	> exige espaço depois de `###`) e o conteúdo abaixo deles fica no trecho do cabeçalho anterior. É o
   679	> comportamento da v1/v2, não foi contestado em nenhuma auditoria, e o corpus atual não usa `####`.
