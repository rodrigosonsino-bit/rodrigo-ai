   846	export class KnowledgeRetriever {
   847	  private readonly byAgent = new Map<string, IndexedChunk[]>();
   848	  private readonly df = new Map<string, Map<string, number>>();
   849	  private readonly avgLen = new Map<string, number>();
   850	
   851	  constructor(chunks: KnowledgeChunk[]) {
   852	    for (const chunk of chunks) {
   853	      const headTerms = normalize(chunk.headingPath);
   854	      const bodyTerms = normalize(chunk.body);
   855	      const tf = new Map<string, number>();
   856	      for (const t of bodyTerms) tf.set(t, (tf.get(t) ?? 0) + 1);
   857	      for (const t of headTerms) tf.set(t, (tf.get(t) ?? 0) + KNOWLEDGE_LIMITS.HEADING_WEIGHT);
   858	
   859	      const list = this.byAgent.get(chunk.agentId) ?? [];
   860	      list.push({ chunk, tf, length: bodyTerms.length + headTerms.length });
   861	      this.byAgent.set(chunk.agentId, list);
   862	
   863	      const dfMap = this.df.get(chunk.agentId) ?? new Map<string, number>();
   864	      for (const t of tf.keys()) dfMap.set(t, (dfMap.get(t) ?? 0) + 1);
   865	      this.df.set(chunk.agentId, dfMap);
   866	    }
   867	    for (const [agentId, list] of this.byAgent) {
   868	      const total = list.reduce((acc, c) => acc + c.length, 0);
   869	      this.avgLen.set(agentId, list.length > 0 ? total / list.length : 0);
   870	    }
   871	  }
   872	
   873	  hasCorpusFor(agentId: string): boolean {
   874	    return (this.byAgent.get(agentId)?.length ?? 0) > 0;
   875	  }
   876	
   877	  get size(): number {
   878	    let n = 0;
   879	    for (const list of this.byAgent.values()) n += list.length;
   880	    return n;
   881	  }
   882	
   883	  /**
   884	   * Monta a query do turno (§4.5). Enriquece com o turno anterior SOMENTE se as três condições
   885	   * valerem juntas: mesmo rótulo, poucos termos próprios, e marcador anafórico explícito.
   886	   * Estática e exportada para ser testável isoladamente.
   887	   */
   888	  static buildQuery(
   889	    currentTranscript: string,
   890	    currentLabel: string,
   891	    previous: PreviousUserTurn | null
   892	  ): string {
   893	    if (previous === null) return currentTranscript;
   894	    if (previous.label !== currentLabel) return currentTranscript;
   895	    const distinct = new Set(normalize(currentTranscript));
   896	    if (distinct.size >= KNOWLEDGE_LIMITS.MIN_QUERY_TERMS) return currentTranscript;
   897	    if (!hasAnaphoraMarker(currentTranscript)) return currentTranscript;
   898	    return `${currentTranscript} ${previous.transcript}`;
   899	  }
   900	
   901	  retrieve(agentId: string, query: string): RetrievedChunk[] {
   902	    const list = this.byAgent.get(agentId);
   903	    const dfMap = this.df.get(agentId);
   904	    const avgLen = this.avgLen.get(agentId);
   905	    if (!list || !dfMap || !avgLen || list.length === 0) return [];
   906	
   907	    const queryTerms = [...new Set(normalize(query))];
   908	    if (queryTerms.length === 0) return [];
   909	
   910	    const N = list.length;
   911	    const { BM25_K1: k1, BM25_B: b } = KNOWLEDGE_LIMITS;
   912	
   913	    const scored = list.map((indexed) => {
   914	      let score = 0;
   915	      for (const term of queryTerms) {
   916	        const f = indexed.tf.get(term);
   917	        if (!f) continue;
   918	        const n = dfMap.get(term) ?? 0;
   919	        const idf = Math.log(1 + (N - n + 0.5) / (n + 0.5));
   920	        const norm = (f * (k1 + 1)) / (f + k1 * (1 - b + b * (indexed.length / avgLen)));
   921	        score += idf * norm;
   922	      }
   923	      return { indexed, score };
   924	    });
   925	
   926	    scored.sort((a, b2) => {
   927	      if (Math.abs(b2.score - a.score) > KNOWLEDGE_LIMITS.SCORE_EPSILON) return b2.score - a.score;
   928	      return a.indexed.chunk.headingPath.localeCompare(b2.indexed.chunk.headingPath);
   929	    });
   930	
   931	    const out: RetrievedChunk[] = [];
   932	    const topScore = scored[0]?.score ?? 0;
   933	    for (const { indexed, score } of scored) {
   934	      if (out.length >= KNOWLEDGE_LIMITS.MAX_CHUNKS) break;
   935	      if (score < KNOWLEDGE_LIMITS.MIN_SCORE) break;
   936	      if (out.length > 0 && score < topScore * KNOWLEDGE_LIMITS.SECONDARY_SCORE_RATIO) break;
   937	      out.push({ headingPath: indexed.chunk.headingPath, body: indexed.chunk.body, score });
   938	    }
   939	    return out;
   940	  }
   941	}
