   764	### 6.4 `src/backend/knowledge/retriever.ts`
   765	
   766	```ts
   767	import { KNOWLEDGE_LIMITS } from '../../shared/voiceProtocol.js';
   768	import { stemPtBr } from './stemmer.js';
   769	import type { KnowledgeChunk } from './corpus.js';
   770	
   771	/**
   772	 * Stopwords PT-BR — SOMENTE palavras funcionais (§4.6): preposições, conjunções, pronomes,
   773	 * artigos, advérbios de ligação, auxiliares e verbos de comando do lado da consulta.
   774	 * A categoria de "substantivos vazios" da v2 (forma, modo, maneira, caso, ponto, parte, vez,
   775	 * coisa e plurais) foi REMOVIDA: substantivo pode ser termo técnico — 'modo' é o modo do batismo
   776	 * em teologia-profile-source.md:91. O IDF do BM25 já penaliza termo disperso.
   777	 * Testada contra o token BRUTO (minúsculo, sem acento), ANTES do stemmer.
   778	 */
   779	const STOPWORDS = new Set([
   780	  'que','com','para','por','uma','uns','umas','dos','das','nos','nas','ser','sao','foi','era',
   781	  'ele','ela','eles','elas','seu','sua','seus','suas','mas','como','mais','menos','nao','sim',
   782	  'sobre','entre','esse','essa','esses','essas','este','esta','isso','aquilo','quando','onde',
   783	  'quem','qual','quais','tem','ter','tudo','todo','toda','todos','todas','the','and','for',
   784	  'dentro','fora','sob','ante','apos','antes','depois','muito','pouco','cada','outro','outra',
   785	  'outros','outras','algum','alguma','alguns','algumas','qualquer','conforme',
   786	  'explique','explicar','explica','diga','dizer','fale','falar','conte','contar','mostre','mostrar',
   787	  'quero','gostaria','poderia','pode','posso','sendo','sido','estar','estao','estava','estamos',
   788	  'fazer','faca','feito','faz','tambem','ainda','entao','assim','porque','pois','desde','ate',
   789	  'numa','num','nesse','nessa','neste','nesta','pelo','pela','pelos','pelas','aos','nem','ora'
   790	]);
   791	
   792	/**
   793	 * Marcadores de anáfora/continuação (§4.5). Testados sobre o TRANSCRIPT BRUTO (minúsculo, sem
   794	 * acento), não sobre os termos normalizados: vários deles (isso, esse, essa, aquilo, este, esta)
   795	 * são stopwords e não sobreviveriam à normalização. Deliberado.
   796	 */
   797	const ANAPHORA_MARKERS =
   798	  /\b(isso|disso|nisso|isto|disto|aquilo|daquilo|ele|ela|dele|dela|deles|delas|esse|essa|esses|essas|este|esta|estes|estas|primeir[oa]|segund[oa]|terceir[oa]|quart[oa]|quint[oa]|ultim[oa]|anterior|melhor|mesm[oa]|ambos|ambas)\b/;
   799	
   800	/** minúsculas, sem acento, só alfanumérico. Etapa compartilhada por todo o pipeline. */
   801	function rawTokens(text: string): string[] {
   802	  return text
   803	    .toLowerCase()
   804	    .normalize('NFD')
   805	    .replace(/[̀-ͯ]/g, '')
   806	    .replace(/[^a-z0-9\s]/g, ' ')
   807	    .split(/\s+/)
   808	    .filter((t) => t.length > 0);
   809	}
   810	
   811	/** rawTokens -> descarta <3 chars e stopwords -> stem -> descarta stem <2 chars. */
   812	export function normalize(text: string): string[] {
   813	  const out: string[] = [];
   814	  for (const token of rawTokens(text)) {
   815	    if (token.length < 3 || STOPWORDS.has(token)) continue;
   816	    const stem = stemPtBr(token);
   817	    if (stem.length >= 2) out.push(stem);
   818	  }
   819	  return out;
   820	}
   821	
   822	export function hasAnaphoraMarker(text: string): boolean {
   823	  return ANAPHORA_MARKERS.test(
