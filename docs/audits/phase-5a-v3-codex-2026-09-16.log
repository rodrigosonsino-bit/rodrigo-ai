   133	
   134	const VOICE_STATE_LABELS: Record<string, string> = {
   135	  idle: 'Parado — clique em "Iniciar conversa" para começar.',
   136	  ouvindo: 'Ouvindo — pode falar.',
   137	  processando: 'Processando sua fala...',
   138	  falando: 'Rodrigo AI está respondendo...',
   139	  aquecendo: 'Aquecendo os modelos locais (pode levar até 2 minutos na primeira vez)...',
   140	  erro: 'Ocorreu um erro. Veja a mensagem no log abaixo.'
   141	};
   142	
   143	const ORCHESTRATOR_LABEL_NAMES: Record<string, string> = {
   144	  GERAL: 'Geral',
   145	  TEOLOGIA: 'Teologia',
   146	  VIRTOLOGIA: 'Virtologia',
   147	  AMBIGUO: 'Ambiguidade'
   148	};
   149	
   150	let muted = false;
   151	
   152	/**
   153	 * O indicador de agente é resetado a cada novo turno ("processando"), erro, ou fim de
   154	 * sessão — nunca mostra o rótulo de um turno que não é mais o atual (Achado 9 da
   155	 * auditoria). Como a sessão só processa um turno por vez (o anterior é sempre cancelado
   156	 * antes de "processando" disparar de novo), esse reset por estado já é suficiente sem
   157	 * precisar rastrear turnId independentemente aqui.
   158	 */
   159	function resetAgentIndicator(): void {
   160	  voiceAgentIndicator.textContent = '';
   161	}
   162	
   163	function appendTranscriptEntry(speaker: 'Você' | 'Rodrigo AI', text: string): void {
   164	  const entry = document.createElement('p');
   165	  entry.className = 'transcript-entry';
   166	  const strong = document.createElement('strong');
   167	  strong.textContent = `${speaker}: `;
   168	  entry.appendChild(strong);
   169	  entry.appendChild(document.createTextNode(text));
   170	  voiceTranscriptLog.appendChild(entry);
   171	  voiceTranscriptLog.scrollTop = voiceTranscriptLog.scrollHeight;
   172	}
   173	
   174	function appendErrorEntry(message: string): void {
   175	  const entry = document.createElement('p');
   176	  entry.className = 'transcript-entry transcript-error';
   177	  entry.textContent = `Erro: ${message}`;
   178	  voiceTranscriptLog.appendChild(entry);
   179	  voiceTranscriptLog.scrollTop = voiceTranscriptLog.scrollHeight;
   180	}
   180	}
   181	
   182	const voiceController = new VoiceController(
   183	  (state) => {
   184	    voiceStateContainer.className = `voice-state voice-state-${state}`;
   185	    voiceStateText.textContent = VOICE_STATE_LABELS[state] || state;
   186	    voiceInterruptBtn.disabled = state !== 'falando';
   187	    // Novo turno começando (processando) ou erro: o rótulo do turno anterior não vale mais.
   188	    if (state === 'processando' || state === 'erro') {
   189	      resetAgentIndicator();
   190	    }
   191	  },
   192	  (text) => appendTranscriptEntry('Você', text),
   193	  (text) => appendTranscriptEntry('Rodrigo AI', text),
   194	  (message) => appendErrorEntry(message),
   195	  (_turnId, label, _handled) => {
   196	    // Checa o rótulo explicitamente (não `handled`) — `!handled` sozinho não garante
   197	    // que o rótulo é AMBIGUO, e presumir isso podia exibir texto enganoso se algum dia
   198	    // deixasse de valer. `handled` não é mais lido aqui (Fase 4: GERAL/TEOLOGIA/VIRTOLOGIA
   199	    // já são todos `handled: true`) — renomeado para `_handled` como `_turnId` acima.
   200	    const name = ORCHESTRATOR_LABEL_NAMES[label] || label;
   201	    voiceAgentIndicator.textContent =
   202	      label === 'AMBIGUO' ? 'Classificado como: AMBÍGUO (respondido pelo agente Geral)' : `Agente: ${name}`;
   203	  }
   204	);
   205	
   206	voiceStartBtn.addEventListener('click', () => {
   207	  void (async () => {
   208	    voiceStartBtn.disabled = true;
   209	    try {
   210	      await voiceController.start();
   211	      voiceEndBtn.disabled = false;
   212	      voiceMuteBtn.disabled = false;
   213	    } catch (error) {
   214	      appendErrorEntry(formatPortugueseErrorMessage(error));
   215	      voiceStartBtn.disabled = false;
   216	    }
   217	  })();
   218	});
   219	
   220	voiceEndBtn.addEventListener('click', () => {
   221	  void (async () => {
   222	    await voiceController.stop();
   223	    voiceStartBtn.disabled = false;
   224	    voiceEndBtn.disabled = true;
   225	    voiceMuteBtn.disabled = true;
   226	    voiceInterruptBtn.disabled = true;
   227	    muted = false;
   228	    voiceMuteBtn.setAttribute('aria-pressed', 'false');
   229	    voiceMuteBtn.textContent = 'Silenciar microfone';
   230	    resetAgentIndicator();
   231	  })();
   232	});
   233	
   234	voiceMuteBtn.addEventListener('click', () => {
   235	  muted = !muted;
   236	  voiceController.muteMicrophone(muted);
   237	  voiceMuteBtn.setAttribute('aria-pressed', String(muted));
   238	  voiceMuteBtn.textContent = muted ? 'Reativar microfone' : 'Silenciar microfone';
   239	});
   240	
   241	voiceInterruptBtn.addEventListener('click', () => {
   242	  voiceController.interruptManually();
   243	});
   244	
   245	window.addEventListener('beforeunload', () => {
   246	  void voiceController.stop();
   247	});

