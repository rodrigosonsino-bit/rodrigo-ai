    86	# (ex.: "3.5"), sem reticências no meio, e com piso mínimo de conteúdo antes de fechar.
    87	_SENTENCE_BOUNDARY = re.compile(r"([.!?]+)(\s+|$)")
    88	
    89	
    90	def find_sentence_boundary(buffer: str) -> Optional[int]:
    91	    """
    92	    Retorna o índice (exclusive, após a pontuação+espaço) do primeiro limite de frase
    93	    seguro em `buffer`, ou None se ainda não há um. Regras:
    94	    - "3.5", "3." seguido de dígito -> não é limite (decimal/numeração).
    95	    - Abreviação conhecida antes do ponto -> não é limite.
    96	    - Reticências "..." contam como um único limite (não um por ponto).
    97	    - Chunk resultante deve ter pelo menos 15 caracteres (senão adia o corte).
    98	    """
    99	    for match in _SENTENCE_BOUNDARY.finditer(buffer):
   100	        end = match.end()
   101	        punct_start = match.start()
   102	
   103	        if end < len(buffer) and buffer[end - 1] != " " and end == len(buffer):
   104	            # ainda não sabemos o que vem depois (pode ser decimal) — espera mais texto
   105	            continue
   106	
   107	        # Reticências: colapsa em um único ponto de corte, não corta no primeiro "."
   108	        if match.group(1).startswith("..") or (
   109	            punct_start > 0 and buffer[punct_start - 1] in ".!?"
   110	        ):
   111	            # se o próximo char depois do espaço também for pontuação, ainda não é o fim real
   112	            pass
   113	
   114	        # Não cortar em decimal: dígito imediatamente antes E depois do ponto (ex.: "3.5")
   115	        if match.group(1) == "." and punct_start > 0 and buffer[punct_start - 1].isdigit():
   116	            after = buffer[end:end + 1]
   117	            if after.isdigit():
   118	                continue
   119	
   120	        # Não cortar em abreviação conhecida (ex.: "Sr.", "Dr.")
   121	        if match.group(1) == ".":
   122	            word_start = punct_start
   123	            while word_start > 0 and (buffer[word_start - 1].isalnum()):
   124	                word_start -= 1
   125	            word = buffer[word_start:punct_start].lower()
   126	            if word in _ABBREVIATIONS:
   127	                continue
   128	
   129	        candidate_len = len(buffer[:end].strip())
   130	        if candidate_len < 15 and end < len(buffer):
   131	            # frase curta demais e ainda há mais texto chegando — deixa acumular
   132	            continue
   133	
   134	        return end
   135	
   136	    return None
   137	
   138	
   139	# --- Detector de loop de repetição (achado fora do escopo da Fase 4, ver
   140	# docs/implementation-phase-4.md e docs/fix-generation-repetition-loop-v2.md) ---
   141	
   142	_WORD_RE = re.compile(r"[^\W_]+", re.UNICODE)
   143	
   144	
   145	def _normalize_for_dedup(text: str) -> str:
   146	    """Normaliza uma frase para comparação de repetição: minúsculas, só palavras, espaços únicos."""
   147	    words = _WORD_RE.findall(text.lower())
   148	    return " ".join(words)
   149	
   150	
   151	def _is_near_duplicate_sentence(
   152	    candidate: str, previously_emitted: list[str], threshold: float = 0.75
   153	) -> bool:
   154	    """
   155	    True se `candidate` repete quase-verbatim (difflib.SequenceMatcher.ratio() >= threshold)
   156	    alguma frase já emitida neste turno (`previously_emitted`, já normalizada). Frases com
   157	    menos de 3 palavras nunca disparam — curtas demais para julgar com confiança sem risco de
   158	    falso positivo em respostas curtas legítimas (a maioria do uso normal). SequenceMatcher (não
   159	    Jaccard de trigramas, que falhava em variações no meio de frases longas — ver auditoria em
   160	    docs/audits/fix-repetition-loop-audit-result-v1-agy.log) porque uma única palavra
   161	    alterada/removida no meio de uma frase não deve derrubar artificialmente a pontuação.
   162	    """
   163	    candidate_norm = _normalize_for_dedup(candidate)
   164	    if len(candidate_norm.split()) < 3:
   165	        return False
   166	
   167	    for prev_norm in previously_emitted:
   168	        if len(prev_norm.split()) < 3:
   169	            continue
   170	        ratio = difflib.SequenceMatcher(None, candidate_norm, prev_norm).ratio()
   171	        if ratio >= threshold:
   172	            return True
   173	    return False
   174	
