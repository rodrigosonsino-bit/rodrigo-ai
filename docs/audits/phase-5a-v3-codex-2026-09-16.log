   681	### 6.3 `src/backend/knowledge/stemmer.ts` (novo — §4.4 e §4.6)
   682	
   683	```ts
   684	/**
   685	 * Stemmer de sufixos reduzido para PT-BR. Determinístico, sem dependência externa.
   686	 * Opera sobre token já em minúsculas e sem acento.
   687	 * Ordem: plural -> feminino -> advérbio -> sufixo nominal -> sufixo verbal -> vogal residual.
   688	 * A última etapa (vogal residual) é a que faz a ponte derivacional que um prefixo fixo não faz:
   689	 *   perdao -> perd ;  perdoar -> perdo -> perd
   690	 * Cada regra é [sufixo, tamanho mínimo do stem resultante, substituição].
   691	 * A PRIMEIRA regra que casa é aplicada; a ordem dentro de cada lista é significativa.
   692	 */
   693	type Rule = readonly [string, number, string];
   694	
   695	const PLURAL: readonly Rule[] = [
   696	  ['ns', 1, 'm'], ['oes', 3, 'ao'], ['aes', 3, 'ao'], ['aos', 3, 'ao'], ['veis', 4, 'vel'],
   697	  ['ais', 2, 'al'], ['eis', 2, 'el'], ['is', 2, 'l'], ['res', 3, 'r'], ['ses', 3, 's'], ['s', 2, '']
   698	];
   699	const PLURAL_EXC = new Set(['lapis', 'cais', 'mais', 'menos', 'ferias', 'pais', 'virus', 'atlas', 'pires']);
   700	
   701	const FEMININO: readonly Rule[] = [
   702	  ['ona', 3, 'ao'], ['ora', 3, 'or'], ['inha', 3, 'inho'], ['esa', 3, 'es'], ['osa', 3, 'oso'],
   703	  ['ica', 3, 'ico'], ['ida', 3, 'ido'], ['ada', 3, 'ado'], ['iva', 3, 'ivo'], ['na', 4, 'no'], ['a', 3, 'o']
   704	];
   705	const FEMININO_EXC = new Set(['cabeca', 'pessoa', 'cara', 'area', 'escola', 'teologia', 'virtologia', 'forma', 'ansiedade']);
   706	
   707	const ADVERBIO: readonly Rule[] = [['mente', 4, '']];
   708	
   709	const NOME: readonly Rule[] = [
   710	  ['alizacao', 5, ''], ['atizacao', 5, ''], ['izacao', 5, ''], ['iamento', 4, ''], ['amento', 3, ''],
   711	  ['imento', 3, ''], ['mento', 6, ''], ['acao', 3, ''], ['icao', 3, ''], ['adora', 3, ''], ['ador', 3, ''],
   712	  ['edor', 3, ''], ['idor', 4, ''], ['ista', 4, ''], ['ismo', 3, ''], ['idade', 4, ''], ['ancia', 3, ''],
   713	  ['encia', 3, ''], ['atorio', 3, ''], ['ario', 3, ''], ['aria', 3, ''], ['eiro', 3, ''], ['eira', 3, ''],
   714	  ['ivel', 5, ''], ['avel', 5, ''], ['agem', 3, ''], ['ivo', 4, ''], ['iva', 4, ''], ['eza', 3, ''],
   715	  ['ez', 4, ''], ['ico', 4, ''], ['ica', 4, ''], ['oso', 3, ''], ['osa', 3, ''], ['ura', 4, ''],
   716	  ['ao', 3, ''], ['ia', 3, '']
   717	];
   718	
   719	const VERBO: readonly Rule[] = [
   720	  ['erias', 5, ''], ['irias', 5, ''], ['assem', 4, ''], ['essem', 4, ''], ['issem', 4, ''],
   721	  ['ando', 3, ''], ['endo', 3, ''], ['indo', 3, ''], ['ondo', 3, ''], ['aram', 3, ''], ['eram', 3, ''],
   722	  ['iram', 3, ''], ['avam', 3, ''], ['arem', 3, ''], ['erem', 3, ''], ['irem', 3, ''], ['amos', 3, ''],
   723	  ['emos', 3, ''], ['imos', 3, ''], ['aste', 3, ''], ['este', 3, ''], ['iste', 3, ''], ['ados', 3, ''],
   724	  ['idos', 3, ''], ['arei', 3, ''], ['erei', 3, ''], ['irei', 3, ''], ['aria', 4, ''], ['eria', 3, ''],
   725	  ['iria', 3, ''], ['ara', 3, ''], ['era', 3, ''], ['ira', 3, ''], ['ada', 3, ''], ['ida', 3, ''],
   726	  ['ado', 3, ''], ['ido', 3, ''], ['ava', 3, ''], ['iam', 3, ''], ['eis', 3, ''],
   727	  ['izar', 3, ''], ['ar', 2, ''], ['er', 2, ''], ['ir', 2, ''], ['am', 2, ''], ['em', 2, ''],
   728	  ['ou', 3, ''], ['ei', 3, ''], ['iu', 3, '']
   729	];
   730	
   731	const VOGAL: readonly Rule[] = [['a', 3, ''], ['e', 3, ''], ['o', 3, '']];
   732	
   733	function applyRules(word: string, rules: readonly Rule[], exceptions: ReadonlySet<string>): [string, boolean] {
   734	  if (exceptions.has(word)) return [word, false];
   735	  for (const [suffix, minStem, replacement] of rules) {
   736	    if (word.endsWith(suffix)) {
   737	      const stem = word.slice(0, word.length - suffix.length);
   738	      if (stem.length >= minStem) return [stem + replacement, true];
   739	    }
   740	  }
   741	  return [word, false];
   742	}
   743	
   744	const NO_EXC: ReadonlySet<string> = new Set();
   745	
   746	export function stemPtBr(word: string): string {
   747	  if (word.length < 3) return word;
   748	  let w = word;
   749	  if (w.endsWith('s')) [w] = applyRules(w, PLURAL, PLURAL_EXC);
   750	  if (w.endsWith('a')) [w] = applyRules(w, FEMININO, FEMININO_EXC);
   751	  [w] = applyRules(w, ADVERBIO, NO_EXC);
   752	  const [nounStem, nounChanged] = applyRules(w, NOME, NO_EXC);
   753	  if (nounChanged) {
   754	    w = nounStem;
   755	  } else {
   756	    const [verbStem, verbChanged] = applyRules(w, VERBO, NO_EXC);
   757	    if (verbChanged) w = verbStem;
   758	  }
   759	  [w] = applyRules(w, VOGAL, NO_EXC);
   760	  return w;
   761	}
   762	```
