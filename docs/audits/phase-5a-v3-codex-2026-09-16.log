    99	function readSse(url: string): { events: unknown[]; close: () => void; waitFor: (n: number, timeoutMs?: number) => Promise<void> } {
   100	  const events: unknown[] = [];
   101	  const controller = new AbortController();
   102	  let resolveWait: (() => void) | null = null;
   103	  let waitCount = 0;
   104	
   105	  fetch(url, { signal: controller.signal }).then(async (res) => {
   106	    const reader = res.body?.getReader();
   107	    if (!reader) return;
   108	    const decoder = new TextDecoder();
   109	    let buffer = '';
   110	    // eslint-disable-next-line no-constant-condition
   111	    while (true) {
   112	      const { done, value } = await reader.read();
   113	      if (done) break;
   114	      buffer += decoder.decode(value, { stream: true });
   115	      const parts = buffer.split('\n\n');
   116	      buffer = parts.pop() || '';
   117	      for (const part of parts) {
   118	        const line = part.split('\n').find((l) => l.startsWith('data: '));
   119	        if (line) {
   120	          events.push(JSON.parse(line.slice(6)));
   121	          if (resolveWait && events.length >= waitCount) {
   122	            resolveWait();
   123	            resolveWait = null;
   124	          }
   125	        }
   126	      }
   127	    }
   128	  }).catch(() => {});
   129	
   130	  return {
   130	  return {
   131	    events,
   132	    close: () => controller.abort(),
   133	    waitFor: (n: number, timeoutMs = 3000) =>
   134	      new Promise<void>((resolve, reject) => {
   135	        if (events.length >= n) {
   136	          resolve();
   137	          return;
   138	        }
   139	        waitCount = n;
   140	        resolveWait = resolve;
   141	        setTimeout(() => reject(new Error(`Timeout esperando ${n} eventos SSE (recebidos: ${events.length})`)), timeoutMs);
   142	      })
   143	  };
   144	}
