    24	async function synthesizeQuestionWav(text, index) {
    25	  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'rodrigo-bench-'));
    26	  const aiff = path.join(tmpDir, `q${index}.aiff`);
    27	  const wav = path.join(tmpDir, `q${index}.wav`);
    28	  await execFileAsync('/usr/bin/say', ['-v', 'Luciana', '-o', aiff, '--', text]);
    29	  await execFileAsync('ffmpeg', ['-y', '-nostdin', '-i', aiff, '-ar', '16000', '-ac', '1', wav]);
    30	  return wav;
    31	}
