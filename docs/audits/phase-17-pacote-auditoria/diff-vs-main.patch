+    tmps.push(dir);
+    const events: DelegationEvent[] = [];
+    let child!: FakeChild;
+    const runner = new ClaudeCodeRunner({
+      resolveRoot: () => ({ ok: true, root: '/work/ro' }),
+      store: new JsonStore<ClaudeJob>(dir, 'j.json'),
+      claudeBin: () => '/fake/claude',
+      spawnFn: () => {
