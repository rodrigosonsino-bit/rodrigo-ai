   151	def _is_near_duplicate_sentence(
   152	    candidate: str, previously_emitted: list[str], threshold: float = 0.75
   153	) -> bool:
   154	    """
   155	    True se `candidate` repete quase-verbatim (difflib.SequenceMatcher.ratio() >= threshold)
   156	    alguma frase já emitida neste turno (`previously_emitted`, já normalizada). Frases com
   157	    menos de 3 palavras nunca disparam — curtas demais para julgar com confiança sem risco de
   158	    falso positivo em respostas curtas legítimas (a maioria do uso normal). SequenceMatcher (não
   159	    Jaccard de trigramas, que falhava em variações no meio de frases longas — ver auditoria em
   160	    docs/audits/fix-repetition-loop-audit-result-v1-agy.log) porque uma única palavra
   161	    alterada/removida no meio de uma frase não deve derrubar artificialmente a pontuação.
   162	    """
   163	    candidate_norm = _normalize_for_dedup(candidate)
   164	    if len(candidate_norm.split()) < 3:
   165	        return False
   166	
   167	    for prev_norm in previously_emitted:
   168	        if len(prev_norm.split()) < 3:
   169	            continue
   170	        ratio = difflib.SequenceMatcher(None, candidate_norm, prev_norm).ratio()
   171	        if ratio >= threshold:
   172	            return True
   173	    return False
