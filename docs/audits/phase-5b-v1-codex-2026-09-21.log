   222	            # não reconhecer intenção de ferramenta deve custar a ferramenta, não o turno.
   223	            if "|" in normalized:
   224	                label_part, _, tool_part = normalized.partition("|")
   225	            else:
   226	                label_part, tool_part = normalized, "NENHUMA"
   227	            label_part = label_part.strip()
   228	            tool_part = tool_part.strip()
   229	
   230	            if label_part not in CLASSIFICATION_LABELS:
   231	                log_diag(f"Saída de classificação fora do formato esperado (turnId={turn_id}).")
   232	                emit({
   233	                    "event": "error", "reqId": req_id, "turnId": turn_id,
   234	                    "message": "Falha ao classificar: formato de saída inesperado.",
