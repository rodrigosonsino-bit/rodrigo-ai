   238	            if tool_part not in TOOL_NAMES:
   239	                log_diag(f"Ferramenta fora do conjunto fechado ({tool_part!r}) — degradando para NENHUMA.")
   240	                tool_part = "NENHUMA"
   241	
   242	            emit({
   243	                "event": "classification", "reqId": req_id, "turnId": turn_id,
   244	                "label": label_part, "tool": tool_part,
   245	            })
   246	```
   247	
   248	com `TOOL_NAMES = {"HORA", "DATA", "NENHUMA"}` junto de `CLASSIFICATION_LABELS`.
