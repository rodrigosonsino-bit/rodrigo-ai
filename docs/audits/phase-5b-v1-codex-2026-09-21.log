   266	      // lançasse (nunca deveria, já que os 3 agentes são sempre registrados juntos e de
   267	      // forma idempotente em voiceRuntime.ts), o turno cai direto no catch externo sem
   268	      // ter anunciado uma transição de estado que não vai se cumprir.
   269	      const agent = selectAgentForLabel(label, this.agents);
   270	
   271	      // Fase 5a: recupera ANTES de emitir routing, pela mesma razão que a Fase 4 resolve o agente
   272	      // antes — nada é anunciado antes de estar decidido. Síncrono e em memória; nunca lança para
   273	      // fora, porque perder a consulta não deve custar a resposta.
   274	      let retrieved: RetrievedChunk[] = [];
