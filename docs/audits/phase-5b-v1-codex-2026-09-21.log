   290	      const knowledgeBlock = buildKnowledgeBlock(retrieved);
   291	      const systemPrompt = knowledgeBlock
   292	        ? `${agent.getSystemPrompt()}\n\n${knowledgeBlock}\n\n${VOICE_SAFETY_AND_OUTPUT_CONSTRAINTS}`
