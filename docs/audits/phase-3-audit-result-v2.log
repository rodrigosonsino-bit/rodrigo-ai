   176	    const isVoice = rms >= threshold;
   177	
   178	    if (speaking) {
   179	      // Barge-in: exige fala sustentada acima do limiar elevado por BARGE_IN_HYSTERESIS_MS
   180	      // antes de interromper — evita que o vazamento acústico do próprio TTS no
   181	      // alto-falante dispare autointerrupção (Achado v2-9 + Refinamento do adendo).
   182	      if (isVoice) {
   183	        this.bargeInCandidateMs += durationMs;
   184	        if (this.bargeInCandidateMs >= BARGE_IN_HYSTERESIS_MS) {
   185	          this.triggerBargeIn();
   186	        }
   187	      } else {
   188	        this.bargeInCandidateMs = 0;
   189	      }
   190	      return;
   191	    }
   192	
   193	    if (!this.recording) {
   194	      this.pushRing(samples, durationMs);
   195	
   196	      if (isVoice) {
   197	        this.continuousVoiceMs += durationMs;
   198	        if (this.continuousVoiceMs >= MIN_VOICE_DURATION_MS) {
   199	          this.beginRecording();
   200	        }
   201	      } else {
   202	        this.continuousVoiceMs = 0;
   203	      }
   204	      return;
   205	    }
   206	
   207	    // Gravando o turno atual
   208	    this.recordedChunks.push(samples);
   209	    this.recordedMs += durationMs;
   210	
   211	    if (isVoice) {
   212	      this.continuousSilenceMs = 0;
   213	    } else {
   214	      this.continuousSilenceMs += durationMs;
   215	    }
   216	
   217	    if (this.continuousSilenceMs >= SILENCE_THRESHOLD_MS || this.recordedMs >= MAX_SEGMENT_MS) {
   218	      void this.finishRecording();
   219	    }
   220	  }
   221	
   222	  private beginRecording(): void {
   223	    this.recording = true;
   224	    this.recordedChunks = [...this.ringBuffer];
   225	    this.recordedMs = this.ringBufferMs;
   226	    this.continuousSilenceMs = 0;
   227	    this.continuousVoiceMs = 0;
   228	    this.ringBuffer = [];
   229	    this.ringBufferMs = 0;
   230	  }
   231	
   232	  private async finishRecording(): Promise<void> {
   233	    this.recording = false;
   234	    const chunks = this.recordedChunks;
   235	    this.recordedChunks = [];
   236	    this.recordedMs = 0;
   237	    this.continuousSilenceMs = 0;
   238	
   239	    const wavBuffer = encodeWavPcm16(chunks, this.sampleRate);
   240	    if (wavBuffer.byteLength === 0) return;
   241	
   242	    this.setState('processando');
   243	
   244	    try {
   245	      const res = await fetch('/api/voice/session/audio', {
   246	        method: 'POST',
   247	        headers: { ...this.headers(), 'Content-Type': 'audio/wav' },
   248	        body: wavBuffer
   249	      });
   250	      if (!res.ok) {
   251	        const body = await res.json().catch(() => ({ error: 'Erro ao enviar áudio.' }));
   252	        this.onError(body.error || 'Erro ao enviar áudio.');
   253	        this.setState('ouvindo');
   254	        return;
   255	      }
   256	      const data = (await res.json()) as AudioTurnResponse;
   257	      this.currentTurnId = data.turnId;
   258	    } catch {
   259	      this.onError('Não foi possível enviar o áudio ao sistema local.');
   260	      this.setState('ouvindo');
   261	    }
   262	  }
   263	
   264	  private triggerBargeIn(): void {
   265	    this.bargeInCandidateMs = 0;
   266	    this.stopPlaybackImmediately();
   267	
   268	    if (this.currentTurnId) {
   269	      void fetch('/api/voice/session/cancel', {
   270	        method: 'POST',
   271	        headers: { ...this.headers(), 'Content-Type': 'application/json' },
   272	        body: JSON.stringify({ turnId: this.currentTurnId })
   273	      });
   274	    }
   275	
   276	    this.playbackQueue = [];
   277	    this.setState('ouvindo');
   278	  }
   279	
   280	  // --- Playback ---
   281	
   282	  private stopPlaybackImmediately(): void {
   283	    if (this.currentSource) {
   284	      try {
   285	        this.currentSource.stop();
   286	      } catch {
   287	        // já pode ter terminado
   288	      }
   289	      this.currentSource = null;
   290	    }
   291	    this.playbackActive = false;
   292	  }
   293	
   294	  private async drainPlaybackQueue(): Promise<void> {
   295	    if (this.playbackActive) return;
   296	    this.playbackActive = true;
   297	
   298	    while (this.playbackQueue.length > 0) {
   299	      const chunk = this.playbackQueue.shift()!;
   300	      if (chunk.turnId !== this.currentTurnId) continue; // frase de um turno superado
   301	
   302	      try {
   303	        await this.playChunk(chunk);
   304	      } catch {
   305	        // erro isolado num chunk não deve travar a fila inteira
   306	      }
   307	    }
   308	
   309	    this.playbackActive = false;
   310	  }
   311	
   312	  private async playChunk(chunk: QueuedChunk): Promise<void> {
   313	    const url = `/api/voice/session/audio/${chunk.audioId}?sessionId=${encodeURIComponent(this.sessionId!)}&token=${encodeURIComponent(this.token!)}`;
   314	    const res = await fetch(url);
   315	    if (!res.ok) return;
   316	    const arrayBuffer = await res.arrayBuffer();
   317	
   318	    if (!this.audioContext) return;
   319	    const audioBuffer = await this.audioContext.decodeAudioData(arrayBuffer);
   320	
   321	    if (chunk.turnId !== this.currentTurnId) return; // cancelado enquanto decodificava
   322	
   323	    await new Promise<void>((resolve) => {
   324	      const source = this.audioContext!.createBufferSource();
   325	      source.buffer = audioBuffer;
   326	      source.connect(this.audioContext!.destination);
   327	      this.currentSource = source;
   328	
   329	      source.onended = () => {
   330	        this.currentSource = null;
   331	        resolve();
   332	      };
   333	
   334	      source.start();
   335	    });
   336	
   337	    if (chunk.turnId !== this.currentTurnId) return; // barge-in ocorreu durante a reprodução
   338	
   339	    this.onAssistantText(chunk.text);
   340	    void fetch('/api/voice/session/played', {
   341	      method: 'POST',
   342	      headers: { ...this.headers(), 'Content-Type': 'application/json' },
   343	      body: JSON.stringify({ turnId: chunk.turnId, text: chunk.text })
   344	    });
   345	  }
   346	
   347	  interruptManually(): void {
   348	    if (this.state === 'falando') {
   349	      this.triggerBargeIn();
   350	    }
   351	  }
   352	
   353	  muteMicrophone(muted: boolean): void {
   354	    this.mediaStream?.getAudioTracks().forEach((track) => {
   355	      track.enabled = !muted;
   356	    });
   357	  }
   358	
   359	  private teardown(): void {
   360	    this.stopPlaybackImmediately();
   361	    this.eventSource?.close();
   362	    this.eventSource = null;
   363	    this.workletNode?.port.close();
   364	    this.workletNode = null;
   365	    this.mediaStream?.getTracks().forEach((t) => t.stop());
   366	    this.mediaStream = null;
   367	    void this.audioContext?.close();
   368	    this.audioContext = null;
   369	    this.sessionId = null;
   370	    this.token = null;
   371	    this.currentTurnId = null;
   372	    this.recording = false;
   373	    this.setState('idle');
   374	  }
   375	
   376	  async stop(): Promise<void> {
   377	    if (this.sessionId && this.token) {
   378	      await fetch('/api/voice/session/end', { method: 'POST', headers: this.headers() }).catch(() => {});
   379	    }
   380	    this.teardown();

