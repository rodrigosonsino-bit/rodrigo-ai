   266	```typescript
   267	private async runTurn(session: Session, turn: ActiveTurn, audioPath: string): Promise<void> {
   268	  try {
   269	    if (!this.engine.isReadySync()) {
   270	      this.emit(session, { type: 'state', state: 'aquecendo' });
   271	      await this.engine.waitUntilReady(VOICE_LIMITS.WARMUP_TIMEOUT_MS);
   272	      if (session.activeTurn !== turn) return;
   273	    }
   274	
   275	    const transcript = await this.engine.transcribe(audioPath);
   276	    if (session.activeTurn !== turn) return;
   277	
   278	    this.emit(session, { type: 'transcript', turnId: turn.turnId, text: transcript });
   279	    session.history.push({ role: 'user', content: transcript });
   280	    this.trimHistory(session);
   281	
   282	    // Correção do Achado 4: classifica ANTES de "falando" — estado continua "processando".
   283	    let label: OrchestratorLabel;
   284	    try {
   285	      label = await this.engine.classify(turn.turnId, turn.epoch, transcript);
   286	    } catch (err) {
   287	      if (session.activeTurn !== turn) return; // cancelado — não é erro real, só encerra
   288	      throw err; // erro real de classificação vira o mesmo tratamento de erro do turno (catch externo)
   289	    }
   290	    if (session.activeTurn !== turn) return;
   291	
   292	    const handled = label === 'GERAL'; // Correção do Achado 3 — sem "|| !specialistAvailable"
   293	    this.emit(session, { type: 'routing', turnId: turn.turnId, label, handled });
   294	
   295	    this.emit(session, { type: 'state', state: 'falando' });
   296	
   297	    const messagesForEngine: ConversationMessage[] = [
   298	      { role: 'system', content: VOICE_SYSTEM_PROMPT },
   299	      ...session.history
   300	    ];
   301	
   302	    await this.engine.generate(turn.turnId, turn.epoch, messagesForEngine, {
   303	      onSentence: (rawText, index) => {
   304	        if (session.activeTurn !== turn) return;
   305	        const text = cleanTextForSpeech(rawText);
   306	        if (!text) return;
   307	        turn.expectedSentences.add(index);
   308	        turn.pendingSynthesis.push(this.synthesizeSentence(session, turn, text, index));
   309	      }
   310	    });
   311	
   312	    await Promise.allSettled(turn.pendingSynthesis);
   313	
   314	    if (session.activeTurn === turn) {
   315	      this.emit(session, { type: 'turn_done', turnId: turn.turnId });
   316	      this.emit(session, { type: 'state', state: 'ouvindo' });
   317	      session.activeTurn = null;
   318	    }
   319	  } catch (err) {
   320	    if (session.activeTurn === turn) {
   321	      this.emit(session, {
   322	        type: 'error', turnId: turn.turnId,
   323	        message: err instanceof Error ? err.message : 'Erro desconhecido.'
   324	      });
   325	      this.emit(session, { type: 'state', state: 'erro' });
   326	      session.activeTurn = null;
   327	    }
   328	  }
   329	}
