   223	      this.emit(session, { type: 'transcript', turnId: turn.turnId, text: transcript });
   224	      session.history.push({ role: 'user', content: transcript });
   225	      this.trimHistory(session);
   226	
   227	      this.emit(session, { type: 'state', state: 'falando' });
   228	
   229	      const messagesForEngine: ConversationMessage[] = [
   230	        { role: 'system', content: VOICE_SYSTEM_PROMPT },
   231	        ...session.history
   232	      ];
   233	
   234	      await this.engine.generate(turn.turnId, turn.epoch, messagesForEngine, {
   235	        onSentence: (rawText, index) => {
   236	          if (session.activeTurn !== turn) return;
   237	          const text = cleanTextForSpeech(rawText);
   238	          if (!text) return; // fragmento não-falável (ex.: só emoji/markdown) — descarta silenciosamente
   239	          turn.expectedSentences.add(index);
   240	          turn.pendingSynthesis.push(this.synthesizeSentence(session, turn, text, index));
   241	        }
   242	      });
   243	
   244	      // Só finaliza o turno (turn_done) depois que toda síntese de frase já disparada
   245	      // realmente terminou — sem isso, turn_done podia chegar ao cliente antes do
   246	      // último sentence_audio_ready (frases geradas rápido demais para o TTS acompanhar).
   247	      await Promise.allSettled(turn.pendingSynthesis);
   248	
   249	      if (session.activeTurn === turn) {
   250	        this.emit(session, { type: 'turn_done', turnId: turn.turnId });
   251	        this.emit(session, { type: 'state', state: 'ouvindo' });
   252	        session.activeTurn = null;
   253	      }
   254	    } catch (err) {
   255	      if (session.activeTurn === turn) {
   256	        this.emit(session, {
   257	          type: 'error',
   258	          turnId: turn.turnId,
   259	          message: err instanceof Error ? err.message : 'Erro desconhecido.'
   260	        });
   261	        this.emit(session, { type: 'state', state: 'erro' });
   262	        session.activeTurn = null;
   263	      }
   264	    }
   265	  }
   266	
   267	  private async synthesizeSentence(session: Session, turn: ActiveTurn, text: string, index: number): Promise<void> {
   268	    const { audioId, filePath } = this.audioStore.newOutputPath(session.id);
   269	    try {
   270	      await this.ttsProvider.synthesize(text, filePath, turn.abortController.signal);
   271	    } catch {
   272	      return; // cancelado ou falhou — não emite evento pra frase obsoleta
   273	    }
   274	
   275	    if (session.activeTurn !== turn) return; // turno superado enquanto sintetizava
   276	
   277	    this.emit(session, {
   278	      type: 'sentence_audio_ready',
   279	      turnId: turn.turnId,
   280	      sentenceIndex: index,
   281	      audioId,
   282	      text
   283	    });
   284	  }
   285	
   286	  /** Confirma que uma frase foi reproduzida até o fim — só então entra no histórico (Refinamento 1). */
   287	  markPlayed(sessionId: string, token: string, turnId: string, text: string): boolean {
   288	    const session = this.getAuthorized(sessionId, token);
   289	    if (!session) return false;
   290	    this.touch(session);
   291	
   292	    // Rejeita confirmações de um turno que não é o mais recente desta sessão — evita que
   293	    // uma reprodução de um turno já superado por barge-in injete texto obsoleto no histórico.
   294	    if (turnId !== session.lastTurnId) return false;
   295	
   296	    session.history.push({ role: 'assistant', content: text });
   297	    this.trimHistory(session);
   298	    return true;
   299	  }
   300	
   301	  cancelTurn(sessionId: string, token: string, turnId: string): boolean {
   302	    const session = this.getAuthorized(sessionId, token);
   303	    if (!session) return false;
   304	    this.touch(session);
   305	
   306	    if (session.activeTurn && session.activeTurn.turnId === turnId) {
   307	      this.engine.cancel(turnId);
   308	      session.activeTurn.abortController.abort();
   309	      session.activeTurn = null;
   310	      this.emit(session, { type: 'state', state: 'ouvindo' });
   311	    }
   312	    return true;
   313	  }
   314	
   315	  async endSession(sessionId: string, token: string): Promise<boolean> {
   316	    const session = this.getAuthorized(sessionId, token);
   317	    if (!session) return false;
   318	    await this.terminate(session, false);
   319	    return true;
   320	  }
   321	
   322	  resolveAudioPath(sessionId: string, token: string, audioId: string): string | null {
   323	    const session = this.getAuthorized(sessionId, token);
   324	    if (!session) return null;
   325	    return this.audioStore.resolveOutputPath(sessionId, audioId);
   326	  }
   327	
   328	  async shutdownAll(): Promise<void> {
   329	    if (this.current) {
   330	      await this.terminate(this.current, false);
   331	    }
   332	  }
   333	}

