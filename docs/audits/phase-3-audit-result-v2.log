   172	  private processAudioBlock(rms: number, samples: Float32Array): void {
   173	    const durationMs = this.blockDurationMs(samples);
   174	    const speaking = this.state === 'falando';
   175	    const threshold = speaking ? RMS_THRESHOLD_WHILE_SPEAKING : RMS_THRESHOLD;
   176	    const isVoice = rms >= threshold;
   177	
   178	    if (speaking) {
   179	      // Barge-in: exige fala sustentada acima do limiar elevado por BARGE_IN_HYSTERESIS_MS
