   200	        }
   201	      } else {
   202	        this.continuousVoiceMs = 0;
   203	      }
   204	      return;
   205	    }
   206	
   207	    // Gravando o turno atual
   208	    this.recordedChunks.push(samples);
   209	    this.recordedMs += durationMs;
   210	
   211	    if (isVoice) {
   212	      this.continuousSilenceMs = 0;
   213	    } else {
   214	      this.continuousSilenceMs += durationMs;
   215	    }
   216	
   217	    if (this.continuousSilenceMs >= SILENCE_THRESHOLD_MS || this.recordedMs >= MAX_SEGMENT_MS) {
