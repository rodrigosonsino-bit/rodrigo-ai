   384	/** Codifica blocos Float32 mono em um WAV PCM 16-bit — sem dependências externas. */
   385	function encodeWavPcm16(chunks: Float32Array[], sampleRate: number): ArrayBuffer {
   386	  const totalSamples = chunks.reduce((sum, c) => sum + c.length, 0);
   387	  if (totalSamples === 0) return new ArrayBuffer(0);
   388	
   389	  const dataSize = totalSamples * 2;
   390	  const buffer = new ArrayBuffer(44 + dataSize);
   391	  const view = new DataView(buffer);
   392	
   393	  function writeString(offset: number, str: string): void {
   394	    for (let i = 0; i < str.length; i += 1) {
   395	      view.setUint8(offset + i, str.charCodeAt(i));
   396	    }
   397	  }
   398	
   399	  writeString(0, 'RIFF');
   400	  view.setUint32(4, 36 + dataSize, true);
   401	  writeString(8, 'WAVE');
   402	  writeString(12, 'fmt ');
   403	  view.setUint32(16, 16, true);
   404	  view.setUint16(20, 1, true); // PCM
   405	  view.setUint16(22, 1, true); // mono
   406	  view.setUint32(24, sampleRate, true);
   407	  view.setUint32(28, sampleRate * 2, true); // byte rate
   408	  view.setUint16(32, 2, true); // block align
   409	  view.setUint16(34, 16, true); // bits per sample
   410	  writeString(36, 'data');
   411	  view.setUint32(40, dataSize, true);
   412	
   413	  let offset = 44;
   414	  for (const chunk of chunks) {
   415	    for (let i = 0; i < chunk.length; i += 1) {
   416	      const clamped = Math.max(-1, Math.min(1, chunk[i]));
   417	      view.setInt16(offset, clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff, true);
   418	      offset += 2;
   419	    }
   420	  }
   421	
   422	  return buffer;
   423	}

