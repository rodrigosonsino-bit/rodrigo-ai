   181	      // alto-falante dispare autointerrupção (Achado v2-9 + Refinamento do adendo).
   182	      if (isVoice) {
   183	        this.bargeInCandidateMs += durationMs;
   184	        if (this.bargeInCandidateMs >= BARGE_IN_HYSTERESIS_MS) {
   185	          this.triggerBargeIn();
   186	        }
   187	      } else {
   188	        this.bargeInCandidateMs = 0;
   189	      }
   190	      return;
   191	    }
   192	
   193	    if (!this.recording) {
   194	      this.pushRing(samples, durationMs);
   195	
   196	      if (isVoice) {
   197	        this.continuousVoiceMs += durationMs;
   198	        if (this.continuousVoiceMs >= MIN_VOICE_DURATION_MS) {
