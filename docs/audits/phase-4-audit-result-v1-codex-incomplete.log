    36	class FakeVoiceProvider implements IVoiceProvider {
    37	  readonly id = 'fake';
    38	  readonly name = 'Fake TTS';
    39	  public synthesizeCalls: string[] = [];
    40	
    41	  isAvailable(): boolean {
    42	    return true;
    43	  }
    44	
    45	  async synthesize(text: string, outputPath: string, signal?: AbortSignal): Promise<void> {
    46	    this.synthesizeCalls.push(text);
    47	    if (signal?.aborted) {
    48	      throw new Error('aborted');
    49	    }
    50	    await fs.promises.writeFile(outputPath, buildTestWav(0.1));
    51	  }
    52	}
