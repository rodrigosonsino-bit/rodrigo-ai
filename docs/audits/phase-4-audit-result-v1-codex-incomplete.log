    18	/**
    19	 * Monta o runtime de voz se — e só se — o setup local (`npm run setup:voice`) já rodou.
    20	 * Ausência de qualquer peça (venv, worker script, modelos) é diagnosticada honestamente
    21	 * em PT-BR; a base da Fase 1 continua funcionando sem depender de Python (B2).
    22	 */
    23	export function createVoiceRuntime(rootDir: string): VoiceRuntime {
    24	  // Usado pela suíte de testes automatizada: garante que `npm test` nunca depende de
    25	  // Python/MLX estarem instalados ou aquecidos, mesmo que .runtime já exista na máquina
    26	  // de quem está rodando os testes (B2: "retorno à base não depende de Python").
    27	  if (process.env.RODRIGO_VOICE_DISABLE === '1') {
    28	    return {
    29	      available: false,
    30	      reason: 'Voz desabilitada explicitamente (RODRIGO_VOICE_DISABLE=1).',
    31	      shutdown: async () => {}
    32	    };
    33	  }
    34	
    35	  const venvPython = path.join(rootDir, '.runtime', '.venv', 'bin', 'python3');
    36	  const workerScript = path.join(rootDir, 'scripts', 'worker', 'worker.py');
    37	  const manifestPath = path.join(rootDir, '.runtime', 'models-manifest.json');
    38	  const hfCacheDir = path.join(rootDir, '.runtime', 'hf-cache');
    39	
    40	  if (!fs.existsSync(venvPython)) {
    41	    return {
    42	      available: false,
    43	      reason: 'Runtime de voz não configurado: rode "npm run setup:voice" primeiro (cria o ambiente Python local e baixa os modelos).',
    44	      shutdown: async () => {}
    45	    };
    46	  }
    47	  if (!fs.existsSync(workerScript)) {
    48	    return {
    49	      available: false,
    50	      reason: `Worker de voz não encontrado em ${workerScript}.`,
    51	      shutdown: async () => {}
    52	    };
    53	  }
    54	  if (!fs.existsSync(manifestPath)) {
    55	    return {
    56	      available: false,
    57	      reason: 'Modelos de voz não baixados: rode "npm run setup:voice" para materializá-los localmente.',
    58	      shutdown: async () => {}
    59	    };
    60	  }
    61	
    62	  const engine = new MlxWorkerEngine({ pythonBin: venvPython, workerScript, hfCacheDir });
    63	  const ttsProvider = selectVoiceProvider();
    64	  ExtensionRegistry.getInstance().registerVoiceProvider(ttsProvider);
    65	  const audioStore = new AudioStore(path.join(rootDir, '.runtime', 'tmp'));
    66	  const sessionManager = new SessionManager(engine, ttsProvider, audioStore);
    67	
    68	  return {
    69	    available: true,
    70	    sessionManager,
    71	    audioStore,
    72	    shutdown: async () => {
    73	      await sessionManager.shutdownAll();
    74	      await engine.shutdown();
    75	    }
    76	  };
    77	}
