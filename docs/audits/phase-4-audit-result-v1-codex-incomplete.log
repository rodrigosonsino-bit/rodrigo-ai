   371	    # --- Thread leitora de stdin (dedicada, nunca bloqueia em inferência) ---
   372	
   373	    def stdin_reader_loop(self) -> None:
   374	        for line in sys.stdin:
   375	            line = line.strip()
   376	            if not line:
   377	                continue
   378	            try:
   379	                msg = json.loads(line)
   380	            except json.JSONDecodeError:
   381	                log_diag("Linha stdin inválida (não é JSON) — ignorada.")
   382	                continue
