    16	  const dataSize = totalSamples * 2;
    17	  const buffer = Buffer.alloc(44 + dataSize);
    18	
    19	  buffer.write('RIFF', 0, 'ascii');
    20	  buffer.writeUInt32LE(36 + dataSize, 4);
    21	  buffer.write('WAVE', 8, 'ascii');
    22	  buffer.write('fmt ', 12, 'ascii');
    23	  buffer.writeUInt32LE(16, 16);
    24	  buffer.writeUInt16LE(1, 20);
    25	  buffer.writeUInt16LE(1, 22);
    26	  buffer.writeUInt32LE(sampleRate, 24);
    27	  buffer.writeUInt32LE(sampleRate * 2, 28);
    28	  buffer.writeUInt16LE(2, 32);
    29	  buffer.writeUInt16LE(16, 34);
    30	  buffer.write('data', 36, 'ascii');
    31	  buffer.writeUInt32LE(dataSize, 40);
    32	  // amostras zeradas (silêncio) bastam para os testes de protocolo
    33	  return buffer;
    34	}
