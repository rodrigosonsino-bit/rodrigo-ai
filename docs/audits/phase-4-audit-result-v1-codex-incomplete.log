    84	# Pontuação terminativa seguida de espaço/quebra/fim-de-string, sem ponto entre dígitos
    85	# (ex.: "3.5"), sem reticências no meio, e com piso mínimo de conteúdo antes de fechar.
    86	_SENTENCE_BOUNDARY = re.compile(r"([.!?]+)(\s+|$)")
    87	
    88	
    89	def find_sentence_boundary(buffer: str) -> Optional[int]:
    90	    """
    91	    Retorna o índice (exclusive, após a pontuação+espaço) do primeiro limite de frase
    92	    seguro em `buffer`, ou None se ainda não há um. Regras:
    93	    - "3.5", "3." seguido de dígito -> não é limite (decimal/numeração).
    94	    - Abreviação conhecida antes do ponto -> não é limite.
    95	    - Reticências "..." contam como um único limite (não um por ponto).
    96	    - Chunk resultante deve ter pelo menos 15 caracteres (senão adia o corte).
    97	    """
    98	    for match in _SENTENCE_BOUNDARY.finditer(buffer):
    99	        end = match.end()
   100	        punct_start = match.start()
   101	
   102	        if end < len(buffer) and buffer[end - 1] != " " and end == len(buffer):
   103	            # ainda não sabemos o que vem depois (pode ser decimal) — espera mais texto
   104	            continue
   105	
   106	        # Reticências: colapsa em um único ponto de corte, não corta no primeiro "."
   107	        if match.group(1).startswith("..") or (
   108	            punct_start > 0 and buffer[punct_start - 1] in ".!?"
   109	        ):
   110	            # se o próximo char depois do espaço também for pontuação, ainda não é o fim real
   111	            pass
   112	
   113	        # Não cortar em decimal: dígito imediatamente antes E depois do ponto (ex.: "3.5")
   114	        if match.group(1) == "." and punct_start > 0 and buffer[punct_start - 1].isdigit():
   115	            after = buffer[end:end + 1]
   116	            if after.isdigit():
   117	                continue
   118	
   119	        # Não cortar em abreviação conhecida (ex.: "Sr.", "Dr.")
   120	        if match.group(1) == ".":
   121	            word_start = punct_start
   122	            while word_start > 0 and (buffer[word_start - 1].isalnum()):
   123	                word_start -= 1
   124	            word = buffer[word_start:punct_start].lower()
   125	            if word in _ABBREVIATIONS:
   126	                continue
   127	
   128	        candidate_len = len(buffer[:end].strip())
   129	        if candidate_len < 15 and end < len(buffer):
   130	            # frase curta demais e ainda há mais texto chegando — deixa acumular
   131	            continue
   132	
   133	        return end
   134	
   135	    return None
