   235	      // que não se importam com o timing fino.
   236	      if (this.classifySettleDelayMs === 0) resolve();
   237	      else setTimeout(resolve, this.classifySettleDelayMs);
   238	    });
   239	
   240	    if (this.cancelledSetHas(turnId)) throw new Error('cancelado');
   241	    return this.classificationToReturn;
   242	  }
   243	
   244	  /** Usado por testes que precisam provar cancelamento síncrono real (Achado 5). */
   245	  public classifySettleDelayMs = 0;
   246	  public isClassifyPending(turnId: string): boolean {
   247	    return this.classifyGate?.turnId === turnId;
   248	  }
   249	
   250	  cancel(turnId: string): void {
   251	    this.cancelledSet.add(turnId);
   252	    this.cancelledTurnIds.push(turnId);
   253	    if (this.classifyGate?.turnId === turnId) {
   254	      this.classifyGate.resolve(); // libera a barreira para a Promise rejeitar no próximo tick
   255	      this.classifyGate = null;
   256	    }
   257	  }
   258	
   259	  private cancelledSetHas(turnId: string): boolean {
   260	    return this.cancelledSet.has(turnId);
   261	  }
   262	}
