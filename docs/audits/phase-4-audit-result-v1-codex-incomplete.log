    38	 * Traduz mensagens de erro de rede para português simples, sem expor mensagens em inglês como "Failed to fetch".
    39	 */
    40	function formatPortugueseErrorMessage(error: unknown): string {
    41	  if (error instanceof DOMException && error.name === 'AbortError') {
    42	    return 'Tempo limite de resposta (5s) esgotado aguardando o sistema local.';
    43	  }
