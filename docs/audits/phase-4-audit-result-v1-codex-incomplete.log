    77	# --- Segmentador de frases PT-BR (Achado v2-3: não fragmentar decimais/abreviações) ---
    78	
    79	_ABBREVIATIONS = {
    80	    "sr", "sra", "srta", "dr", "dra", "prof", "profa", "ex", "etc",
    81	    "ltda", "vs", "pág", "p", "ed", "nº", "art", "cap"
