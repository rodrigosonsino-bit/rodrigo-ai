   389	/** Codifica blocos Float32 mono em um WAV PCM 16-bit — sem dependências externas. */
   390	function encodeWavPcm16(chunks: Float32Array[], sampleRate: number): ArrayBuffer {
   391	  const totalSamples = chunks.reduce((sum, c) => sum + c.length, 0);
   392	  if (totalSamples === 0) return new ArrayBuffer(0);
   393	
   394	  const dataSize = totalSamples * 2;
   395	  const buffer = new ArrayBuffer(44 + dataSize);
   396	  const view = new DataView(buffer);
   397	
   398	  function writeString(offset: number, str: string): void {
   399	    for (let i = 0; i < str.length; i += 1) {
   400	      view.setUint8(offset + i, str.charCodeAt(i));
   401	    }
   402	  }
   403	
   404	  writeString(0, 'RIFF');
   405	  view.setUint32(4, 36 + dataSize, true);
   406	  writeString(8, 'WAVE');
   407	  writeString(12, 'fmt ');
   408	  view.setUint32(16, 16, true);
   409	  view.setUint16(20, 1, true); // PCM
   410	  view.setUint16(22, 1, true); // mono
   411	  view.setUint32(24, sampleRate, true);
   412	  view.setUint32(28, sampleRate * 2, true); // byte rate
   413	  view.setUint16(32, 2, true); // block align
   414	  view.setUint16(34, 16, true); // bits per sample
   415	  writeString(36, 'data');
   416	  view.setUint32(40, dataSize, true);
   417	
   418	  let offset = 44;
   419	  for (const chunk of chunks) {
   420	    for (let i = 0; i < chunk.length; i += 1) {
   421	      const clamped = Math.max(-1, Math.min(1, chunk[i]));
   422	      view.setInt16(offset, clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff, true);
   423	      offset += 2;
   424	    }
   425	  }
   426	
   427	  return buffer;
   428	}
