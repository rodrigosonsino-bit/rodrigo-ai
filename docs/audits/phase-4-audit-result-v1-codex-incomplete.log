   123	### Node — `MlxWorkerEngine` (src/backend/voice/mlxWorkerEngine.ts) — mudanças completas
   124	```typescript
   125	const CLASSIFY_TIMEOUT_MS = 10_000;
   126	const CLASSIFICATION_LABELS = new Set(['GERAL', 'TEOLOGIA', 'VIRTOLOGIA', 'AMBIGUO']);
   127	
   128	interface PendingClassify {
   129	  kind: 'classify';
   130	  turnId: string;
   131	  resolve: (label: OrchestratorLabel) => void;
   132	  reject: (err: Error) => void;
   133	  timeout: NodeJS.Timeout;
   134	  spawnGeneration: number;
   135	}
   136	// Pending vira: type Pending = PendingTranscribe | PendingGenerate | PendingClassify;
   137	// PendingGenerate ganha o mesmo campo `spawnGeneration: number`.
   138	
   139	class MlxWorkerEngine implements VoiceEngine {
   140	  private spawnGeneration = 0; // incrementado a cada spawnWorker()
   141	
   142	  private spawnWorker(): void {
   143	    this.spawnGeneration += 1;
   144	    // ...resto do método igual ao já implementado...
   145	  }
   146	
   147	  async classify(turnId: string, epoch: number, text: string): Promise<OrchestratorLabel> {
   148	    const reqId = nextReqId();
   149	    const spawnGeneration = this.spawnGeneration;
   150	    return new Promise((resolve, reject) => {
   151	      const timeout = setTimeout(() => {
   152	        this.pending.delete(reqId);
   153	        reject(new VoiceEngineError(`Classificação do turno ${turnId} excedeu ${CLASSIFY_TIMEOUT_MS}ms.`));
   154	        if (this.spawnGeneration === spawnGeneration) {
   155	          this.child?.kill('SIGKILL'); // só mata a instância que ainda é a atual
   156	        }
   157	      }, CLASSIFY_TIMEOUT_MS);
   158	
   159	      this.pending.set(reqId, { kind: 'classify', turnId, resolve, reject, timeout, spawnGeneration });
   160	
   161	      try {
   162	        this.writeCommand({ cmd: 'classify', reqId, turnId, epoch, text });
   163	      } catch (err) {
   164	        clearTimeout(timeout);
   165	        this.pending.delete(reqId);
   166	        reject(err as Error);
   167	      }
   168	    });
   169	  }
   170	
   171	  cancel(turnId: string): void {
   172	    // Resolve/rejeita localmente QUALQUER pending deste turnId, sem esperar o worker —
   173	    // corrige Achados 1 e 2: o Node nunca fica preso esperando uma confirmação que pode
   174	    // nunca chegar (comando descartado da fila, worker morto, etc.).
   175	    for (const [reqId, pending] of this.pending) {
   176	      if (pending.kind === 'transcribe') continue; // transcribe não carrega turnId hoje — fora de escopo
   177	      if (pending.turnId !== turnId) continue;
   178	
   179	      this.pending.delete(reqId);
   180	      clearTimeout(pending.timeout);
   181	
   182	      if (pending.kind === 'classify') {
   183	        pending.reject(new VoiceEngineError(`Classificação do turno ${turnId} cancelada.`));
   184	      } else {
   185	        pending.resolve(); // generate() cancelado: resolve (não é erro) — turno já é abandonado pelo chamador
   186	      }
   187	    }
   188	
   189	    try {
   190	      this.writeCommand({ cmd: 'cancel', turnId }); // best-effort: só evita trabalho desperdiçado no worker
   191	    } catch {
   192	      // worker indisponível — sem problema, já resolvemos localmente acima
   193	    }
   194	  }
   195	
   196	  private handleLine(line: string): void {
   197	    // ...trecho existente inalterado até chegar no switch por evento...
   198	    const pending = this.pending.get(reqId);
   199	    if (!pending) return; // resultado de um reqId já cancelado/substituído — ignora (corrige Achado 2)
   200	
   201	    if (event === 'classification' && pending.kind === 'classify') {
   202	      this.pending.delete(reqId);
   203	      clearTimeout(pending.timeout);
   204	      const label = msg.label as string;
   205	      if (!CLASSIFICATION_LABELS.has(label)) {
   206	        pending.reject(new VoiceEngineError('Worker retornou rótulo de classificação inválido.'));
   207	        return;
   208	      }
   209	      pending.resolve(label as OrchestratorLabel);
   210	      return;

