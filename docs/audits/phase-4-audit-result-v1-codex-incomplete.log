   356	    def work_loop(self) -> None:
   357	        while True:
   358	            msg = self.work_queue.get()
   359	            cmd = msg.get("cmd")
   360	            try:
   361	                if cmd == "transcribe":
   362	                    self.handle_transcribe(msg)
   363	                elif cmd == "classify":
   364	                    self.handle_classify(msg)
   365	                elif cmd == "generate":
   366	                    self.handle_generate(msg)
   367	            except Exception as exc:  # noqa: BLE001
   368	                log_diag(f"Erro não tratado no work_loop: {exc}\n{traceback.format_exc()}")
   369	                emit({"event": "error", "message": "Falha interna do worker."})
