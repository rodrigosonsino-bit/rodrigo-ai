    60	function percentile(values, p) {
    61	  const sorted = [...values].sort((a, b) => a - b);
    62	  const idx = Math.ceil((p / 100) * sorted.length) - 1;
    63	  return sorted[Math.max(0, Math.min(sorted.length - 1, idx))];
    64	}
    65	
    66	async function runOneTurn(sessionId, token, wavPath, sse) {
    67	  const audioBuffer = fs.readFileSync(wavPath);
    68	  const tSent = performance.now();
    69	
    70	  const res = await fetch(`${BASE_URL}/api/voice/session/audio`, {
    71	    method: 'POST',
    72	    headers: { 'X-Rodrigo-Session': sessionId, 'X-Rodrigo-Token': token, 'Content-Type': 'audio/wav' },
    73	    body: audioBuffer
    74	  });
    75	  if (!res.ok) {
    76	    throw new Error(`Falha ao enviar áudio: ${res.status} ${await res.text()}`);
    77	  }
    78	  const { turnId } = await res.json();
    79	
    80	  const deadline = Date.now() + 30_000;
    81	  let tTranscript = null;
    82	  let tFirstAudio = null;
    83	  let tDone = null;
    84	
    85	  const startLen = sse.events.length;
    86	  while (Date.now() < deadline) {
    87	    for (let i = startLen; i < sse.events.length; i += 1) {
    88	      const { t, event } = sse.events[i];
    89	      if (event.turnId && event.turnId !== turnId) continue;
    90	      if (event.type === 'transcript' && tTranscript === null) tTranscript = t;
    91	      if (event.type === 'sentence_audio_ready' && tFirstAudio === null) tFirstAudio = t;
    92	      if (event.type === 'turn_done') tDone = t;
    93	    }
    94	    if (tDone !== null) break;
    95	    await new Promise((r) => setTimeout(r, 50));
    96	  }
    97	
    98	  if (tFirstAudio === null) {
    99	    throw new Error(`Turno ${turnId} não produziu áudio dentro do timeout de 30s.`);
   100	  }
   101	
   102	  return {
   103	    sttMs: tTranscript ? tTranscript - tSent : null,
   104	    firstAudioMs: tFirstAudio - tSent,
   105	    totalMs: (tDone || tFirstAudio) - tSent
   106	  };
   107	}
