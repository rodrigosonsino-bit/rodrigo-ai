    33	function readSse(url) {
    34	  const events = [];
    35	  const controller = new AbortController();
    36	
    37	  const promise = fetch(url, { signal: controller.signal }).then(async (res) => {
    38	    const reader = res.body.getReader();
    39	    const decoder = new TextDecoder();
    40	    let buffer = '';
    41	    // eslint-disable-next-line no-constant-condition
    42	    while (true) {
    43	      const { done, value } = await reader.read();
    44	      if (done) break;
    45	      buffer += decoder.decode(value, { stream: true });
    46	      const parts = buffer.split('\n\n');
    47	      buffer = parts.pop() || '';
    48	      for (const part of parts) {
    49	        const line = part.split('\n').find((l) => l.startsWith('data: '));
    50	        if (line) {
    51	          events.push({ t: performance.now(), event: JSON.parse(line.slice(6)) });
    52	        }
    53	      }
    54	    }
    55	  }).catch(() => {});
    56	
    57	  return { events, close: () => controller.abort(), promise };
    58	}
