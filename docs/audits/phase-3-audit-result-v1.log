    21	/** Remove markdown e emoji do texto antes de mandar pro TTS — defesa complementar ao prompt acima. */
    22	function cleanTextForSpeech(text: string): string {
    23	  let cleaned = text
    24	    .replace(/\*\*(.*?)\*\*/g, '$1')
    25	    .replace(/\*(.*?)\*/g, '$1')
    26	    .replace(/`([^`]*)`/g, '$1')
    27	    .replace(/#{1,6}\s*/g, '')
    28	    .replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{FE0F}]/gu, '')
    29	    .replace(/\s+/g, ' ')
    30	    .trim();
    31	  return cleaned;
    32	}
