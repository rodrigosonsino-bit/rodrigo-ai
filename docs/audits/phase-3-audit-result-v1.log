    54	interface Harness {
    55	  server: http.Server;
    56	  baseUrl: string;
    57	  engine: FakeVoiceEngine;
    58	  tts: FakeVoiceProvider;
    59	  audioStore: AudioStore;
    60	  sessionManager: SessionManager;
    61	  tmpDir: string;
    62	}
