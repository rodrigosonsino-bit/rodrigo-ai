    64	# Pontuação terminativa seguida de espaço/quebra/fim-de-string, sem ponto entre dígitos
    65	# (ex.: "3.5"), sem reticências no meio, e com piso mínimo de conteúdo antes de fechar.
    66	_SENTENCE_BOUNDARY = re.compile(r"([.!?]+)(\s+|$)")
    67	
    68	
    69	def find_sentence_boundary(buffer: str) -> Optional[int]:
    70	    """
    71	    Retorna o índice (exclusive, após a pontuação+espaço) do primeiro limite de frase
    72	    seguro em `buffer`, ou None se ainda não há um. Regras:
    73	    - "3.5", "3." seguido de dígito -> não é limite (decimal/numeração).
    74	    - Abreviação conhecida antes do ponto -> não é limite.
    75	    - Reticências "..." contam como um único limite (não um por ponto).
    76	    - Chunk resultante deve ter pelo menos 15 caracteres (senão adia o corte).
    77	    """
    78	    for match in _SENTENCE_BOUNDARY.finditer(buffer):
    79	        end = match.end()
    80	        punct_start = match.start()
    81	
    82	        if end < len(buffer) and buffer[end - 1] != " " and end == len(buffer):
    83	            # ainda não sabemos o que vem depois (pode ser decimal) — espera mais texto
    84	            continue
    85	
    86	        # Reticências: colapsa em um único ponto de corte, não corta no primeiro "."
    87	        if match.group(1).startswith("..") or (
    88	            punct_start > 0 and buffer[punct_start - 1] in ".!?"
    89	        ):
    90	            # se o próximo char depois do espaço também for pontuação, ainda não é o fim real
    91	            pass
    92	
    93	        # Não cortar em decimal: dígito imediatamente antes E depois do ponto (ex.: "3.5")
    94	        if match.group(1) == "." and punct_start > 0 and buffer[punct_start - 1].isdigit():
    95	            after = buffer[end:end + 1]
    96	            if after.isdigit():
    97	                continue
    98	
    99	        # Não cortar em abreviação conhecida (ex.: "Sr.", "Dr.")
   100	        if match.group(1) == ".":
   101	            word_start = punct_start
   102	            while word_start > 0 and (buffer[word_start - 1].isalnum()):
   103	                word_start -= 1
   104	            word = buffer[word_start:punct_start].lower()
   105	            if word in _ABBREVIATIONS:
   106	                continue
   107	
   108	        candidate_len = len(buffer[:end].strip())
   109	        if candidate_len < 15 and end < len(buffer):
   110	            # frase curta demais e ainda há mais texto chegando — deixa acumular
   111	            continue
   112	
   113	        return end
   114	
   115	    return None
