   212	  private async runTurn(session: Session, turn: ActiveTurn, audioPath: string): Promise<void> {
   213	    try {
   214	      if (!this.engine.isReadySync()) {
   215	        this.emit(session, { type: 'state', state: 'aquecendo' });
