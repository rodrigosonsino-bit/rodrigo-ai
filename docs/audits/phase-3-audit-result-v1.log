     9	const QUESTIONS = [
    10	  'Quanto é dois mais dois?',
    11	  'Que horas são agora?',
    12	  'Qual é a capital do Brasil?',
    13	  'Me diga um número entre um e dez.',
    14	  'Como você está?',
