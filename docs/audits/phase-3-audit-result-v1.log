    62	            raw += response.text
    63	
    64	        label = raw.strip().upper().strip(".!?")
    65	        # Normalização defensiva: o LLM pode devolver variações (ex. "Geral.", "teologia")
    66	        matched = next((l for l in CLASSIFICATION_LABELS if l in label), "AMBIGUO")
    67	
    68	        emit({"event": "classification", "reqId": req_id, "turnId": turn_id, "label": matched})
    69	    except Exception as exc:  # noqa: BLE001
    70	        log_diag(f"Erro na classificação: {exc}\n{traceback.format_exc()}")
    71	        emit({"event": "error", "reqId": req_id, "turnId": turn_id, "message": "Falha ao classificar a intenção."})
    72	    finally:
    73	        with self._current_lock:
    74	            if self._current is handle:
    75	                self._current = None
    76	        if self._mx is not None:
    77	            self._mx.clear_cache()
    78	```
