    15	/**
    16	 * Atualiza o status visual e acessível (via role="status" e aria-live="polite").
    17	 */
    18	function setStatus(
    19	  type: 'loading' | 'connected' | 'error',
    20	  message: string,
    21	  details?: { status: string; version: string }
    22	): void {
    23	  statusContainer.className = `status-indicator ${type}`;
