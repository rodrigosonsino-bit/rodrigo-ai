    64	async function setupHarness(): Promise<Harness> {
    65	  const testConfig: AppConfig = { port: 0, host: '127.0.0.1', clientPort: 0 };
    66	  // porta 0 -> o SO escolhe uma porta livre; startServer atual exige config.port fixo,
    67	  // então usamos uma porta alta fixa por teste para simplicidade e paralelismo seguro.
    68	  const port = 20000 + Math.floor(Math.random() * 5000);
    69	  const config: AppConfig = { port, host: '127.0.0.1', clientPort: port + 1 };
    70	
    71	  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'rodrigo-voice-test-'));
    72	  const engine = new FakeVoiceEngine();
    73	  const tts = new FakeVoiceProvider();
    74	  const audioStore = new AudioStore(tmpDir);
    75	  const sessionManager = new SessionManager(engine, tts, audioStore);
    76	
    77	  const server = await startServer(config, undefined, { config, sessionManager, audioStore });
    78	
    79	  return { server, baseUrl: `http://127.0.0.1:${port}`, engine, tts, audioStore, sessionManager, tmpDir };
    80	}
    81	
    82	async function teardownHarness(h: Harness): Promise<void> {
    83	  // Cada sessão criada arma um setTimeout de 10min (idle timeout) que mantém o processo
    84	  // vivo se nada o limpar — shutdownAll() encerra a sessão atual e cancela esse timer
    85	  // (é o que voiceRuntime.shutdown() já faz em produção antes de fechar o servidor HTTP).
    86	  await h.sessionManager.shutdownAll();
    87	
    88	  // server.close() por si só espera conexões abertas (ex.: SSE) fecharem sozinhas, e
    89	  // closeAllConnections() sozinho não derruba conexões keep-alive ociosas — sem as duas
    90	  // juntas, close() pode travar em teste.
    91	  const closePromise = new Promise<void>((resolve) => h.server.close(() => resolve()));
    92	  h.server.closeAllConnections();
    93	  h.server.closeIdleConnections();
    94	  await closePromise;
    95	  await fs.promises.rm(h.tmpDir, { recursive: true, force: true }).catch(() => {});
    96	}
