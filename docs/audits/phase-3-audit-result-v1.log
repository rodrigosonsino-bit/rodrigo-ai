    56	/**
    57	 * Executa a verificação real da saúde do sistema local.
    58	 * Mantém o timeout ativo durante toda a requisição e leitura do corpo JSON.
    59	 */
    60	async function checkHealth(): Promise<void> {
    61	  // Prevenir requisições concorrentes
    62	  if (isChecking) {
    63	    return;
    64	  }
    65	
    66	  isChecking = true;
    67	  retryButton.disabled = true;
    68	  setStatus('loading', 'Verificando conexão com o sistema neste computador...');
    69	
    70	  const controller = new AbortController();
    71	  let timeoutId: number | undefined;
    72	
    73	  try {
    74	    timeoutId = window.setTimeout(() => {
    75	      controller.abort();
    76	    }, 5000);
    77	
    78	    const response = await fetch('/api/health', {
    79	      method: 'GET',
    80	      headers: {
    81	        Accept: 'application/json'
    82	      },
    83	      signal: controller.signal
    84	    });
    85	
    86	    if (!response.ok) {
    87	      throw new Error(`O sistema retornou uma resposta inesperada (código ${response.status}).`);
    88	    }
    89	
    90	    // Leitura e parse do JSON protegidos pelo mesmo timeout
    91	    const data = (await response.json()) as HealthResponse;
    92	
    93	    if (data && data.status === 'ok' && data.version === '0.1.0') {
    94	      setStatus('connected', 'Tudo pronto neste computador. O sistema está conectado e respondendo normalmente.', {
    95	        status: 'Ativo',
    96	        version: data.version
    97	      });
    98	    } else {
    99	      throw new Error('Formato de resposta do sistema não reconhecido.');
   100	    }
   101	  } catch (error: unknown) {
   102	    const friendlyError = formatPortugueseErrorMessage(error);
   103	    setStatus('error', `Falha de conexão: ${friendlyError} Clique em "Tentar novamente".`);
   104	  } finally {
   105	    if (timeoutId !== undefined) {
   106	      window.clearTimeout(timeoutId);
   107	    }
   108	    isChecking = false;
   109	    retryButton.disabled = false;
   110	  }
   111	}
   112	
   113	// Vinculação de eventos
   114	retryButton.addEventListener('click', () => {
   115	  checkHealth();
   116	});
   117	
   118	// Verificação inicial ao carregar a página
   119	document.addEventListener('DOMContentLoaded', () => {
   120	  checkHealth();
   121	});
