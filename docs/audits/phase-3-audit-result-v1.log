   109	async function main() {
   110	  console.log(`[bench] Conectando em ${BASE_URL} — certifique-se que "npm start" ou "npm run dev" já está rodando com o runtime de voz configurado.`);
   111	
   112	  const createRes = await fetch(`${BASE_URL}/api/voice/session`, { method: 'POST' });
   113	  if (!createRes.ok) {
   114	    console.error(`[bench] Não foi possível criar sessão (${createRes.status}). Voz local está configurada? Rode "npm run setup:voice".`);
   115	    process.exit(1);
   116	  }
   117	  const { sessionId, token } = await createRes.json();
   118	
   119	  const sse = readSse(`${BASE_URL}/api/voice/session/events?sessionId=${sessionId}&token=${token}`);
   120	  await new Promise((r) => setTimeout(r, 300));
   121	
   122	  console.log('[bench] Sintetizando perguntas de teste com "say" (entrada sintética, não é o teste humano de verdade)...');
   123	  const wavPaths = [];
   124	  for (let i = 0; i < QUESTIONS.length; i += 1) {
   125	    wavPaths.push(await synthesizeQuestionWav(QUESTIONS[i], i));
   126	  }
   127	
   128	  console.log('[bench] Aquecendo (1ª pergunta, ignorada nas métricas — pode levar até 2min)...');
   129	  await runOneTurn(sessionId, token, wavPaths[0], sse);
   130	
   131	  const results = [];
   132	  for (let i = 1; i < wavPaths.length; i += 1) {
   133	    console.log(`[bench] Turno ${i}/${wavPaths.length - 1}: "${QUESTIONS[i]}"`);
   134	    const r = await runOneTurn(sessionId, token, wavPaths[i], sse);
   135	    console.log(`  STT: ${r.sttMs?.toFixed(0) ?? 'n/d'}ms | 1º áudio: ${r.firstAudioMs.toFixed(0)}ms | total: ${r.totalMs.toFixed(0)}ms`);
   136	    results.push(r);
   137	    await new Promise((res) => setTimeout(res, 500));
   138	  }
