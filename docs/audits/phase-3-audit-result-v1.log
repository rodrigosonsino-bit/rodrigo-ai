    37	/**
    38	 * Traduz mensagens de erro de rede para português simples, sem expor mensagens em inglês como "Failed to fetch".
    39	 */
    40	function formatPortugueseErrorMessage(error: unknown): string {
    41	  if (error instanceof DOMException && error.name === 'AbortError') {
    42	    return 'Tempo limite de resposta (5s) esgotado aguardando o sistema local.';
    43	  }
    44	
    45	  if (error instanceof Error) {
    46	    const msg = error.message.toLowerCase();
    47	    if (msg.includes('fetch') || msg.includes('network') || msg.includes('failed') || msg.includes('load failed')) {
    48	      return 'Não foi possível conectar ao sistema neste computador. Verifique se o serviço está em execução.';
    49	    }
    50	    return error.message;
    51	  }
    52	
    53	  return 'Ocorreu uma falha inesperada ao comunicar com o sistema local.';
    54	}
