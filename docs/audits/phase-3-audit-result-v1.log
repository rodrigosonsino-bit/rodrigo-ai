    32	def handle_classify(self, msg: dict[str, Any]) -> None:
    33	    req_id = msg["reqId"]
    34	    turn_id = msg["turnId"]
    35	    epoch = msg["epoch"]
    36	    text = msg["text"]
    37	
    38	    handle = GenerationHandle(turn_id=turn_id, epoch=epoch)
    39	    with self._current_lock:
    40	        self._current = handle
    41	
    42	    try:
    43	        messages = [
    44	            {"role": "system", "content": CLASSIFICATION_SYSTEM_PROMPT},
    45	            {"role": "user", "content": text},
    46	        ]
    47	        prompt = self._llm_tokenizer.apply_chat_template(
    48	            messages, add_generation_prompt=True, tokenize=False
    49	        )
    50	
    51	        from mlx_lm.generate import stream_generate
    52	        from mlx_lm.sample_utils import make_sampler
    53	
    54	        sampler = make_sampler(temp=0.0)  # determinístico — é uma classificação, não geração criativa
    55	        raw = ""
    56	        for response in stream_generate(
    57	            self._llm, self._llm_tokenizer, prompt, max_tokens=8, sampler=sampler
    58	        ):
