     2	 * Contratos compartilhados do protocolo de voz da Fase 2 (frontend <-> backend).
     3	 * Eventos SSE emitidos em GET /api/voice/session/events.
     4	 */
     5	
     6	export type VoiceState = 'ouvindo' | 'processando' | 'falando' | 'aquecendo' | 'erro';
     7	
     8	export interface StateEvent {
     9	  type: 'state';
    10	  state: VoiceState;
    11	}
    12	
    13	export interface TranscriptEvent {
    14	  type: 'transcript';
    15	  turnId: string;
    16	  text: string;
    17	}
    18	
    19	export interface SentenceAudioReadyEvent {
    20	  type: 'sentence_audio_ready';
    21	  turnId: string;
    22	  sentenceIndex: number;
    23	  audioId: string;
    24	  text: string;
    25	}
    26	
    27	export interface TurnDoneEvent {
    28	  type: 'turn_done';
    29	  turnId: string;
    30	}
    31	
    32	export interface SessionPreemptedEvent {
    33	  type: 'session_preempted';
    34	}
    35	
    36	export interface ErrorEvent {
    37	  type: 'error';
    38	  message: string;
    39	  turnId?: string;
    40	}
    41	
    42	export type VoiceServerEvent =
    43	  | StateEvent
    44	  | TranscriptEvent
    45	  | SentenceAudioReadyEvent
    46	  | TurnDoneEvent
    47	  | SessionPreemptedEvent
    48	  | ErrorEvent;
    49	
    50	export interface CreateSessionResponse {
    51	  sessionId: string;
    52	  token: string;
    53	}
    54	
    55	export interface AudioTurnResponse {
    56	  turnId: string;
    57	}
    58	
    59	/**
    60	 * Mensagem de histórico confirmada (só entra depois que o cliente reproduziu o áudio até o fim).
    61	 */
    62	export interface ConversationMessage {
    63	  role: 'system' | 'user' | 'assistant';
    64	  content: string;
    65	}
    66	
    67	export const VOICE_LIMITS = {
    68	  MAX_AUDIO_BYTES: 2 * 1024 * 1024,
    69	  MAX_AUDIO_SECONDS: 20,
    70	  MAX_TEXT_CHARS: 2000,
    71	  MAX_TURN_TOKENS: 160,
    72	  MAX_CONTEXT_TURNS: 8,
    73	  MAX_CONTEXT_TOKENS: 4096,
    74	  TURN_TIMEOUT_MS: 60_000,
