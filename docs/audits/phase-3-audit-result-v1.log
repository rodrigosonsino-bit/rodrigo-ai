     1	#!/usr/bin/env python3
     2	"""
     3	Worker persistente de voz local (Fase 2, Rodrigo AI).
     4	
     5	Protocolo: NDJSON via stdin/stdout.
     6	- stdout carrega EXCLUSIVAMENTE o protocolo (uma linha JSON por evento). Nunca escrever
     7	  transcrições, texto de conversa ou segredos em stderr; stderr é só para diagnóstico técnico.
     8	- Comandos chegam por stdin (um JSON por linha): transcribe, generate, cancel, ping.
     9	- Uma thread dedicada (`_stdin_reader_loop`) lê stdin continuamente e nunca bloqueia em
    10	  inferência — comandos "cancel" são aplicados imediatamente a partir dela, mesmo enquanto
    11	  a thread de trabalho está presa dentro de stream_generate (achado de auditoria: um único
    12	  thread que faz as duas coisas não consegue processar cancelamento a tempo).
    13	- Apenas uma tarefa de inferência roda por vez (fila de tamanho 1): um novo comando
    14	  "generate" cancela e substitui qualquer geração em andamento, nunca enfileira atrás dela.
    15	
    16	Modelos (MLX, 100% local, sem rede em operação):
    17	- LLM: mlx-community/Qwen3-4B-Instruct-2507-4bit
    18	- STT: mlx-community/whisper-small-mlx
    19	
    20	Offline por padrão: HF_HUB_OFFLINE=1 / TRANSFORMERS_OFFLINE=1 são setados antes de importar
    21	qualquer biblioteca de rede, exceto durante o setup explícito (scripts/setup-voice.mjs), que
    22	roda este mesmo worker com HF_HUB_OFFLINE=0 apenas para baixar/materializar os modelos.
    23	"""
    24	import json
    25	import os
    26	import queue
    27	import re
    28	import sys
    29	import threading
    30	import time
    31	import traceback
    32	from dataclasses import dataclass, field
    33	from typing import Any, Optional
    34	
    35	# Offline em operação normal — o setup script sobrescreve isso explicitamente para baixar modelos.
    36	if os.environ.get("RODRIGO_VOICE_SETUP") != "1":
    37	    os.environ.setdefault("HF_HUB_OFFLINE", "1")
    38	    os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
    39	
    40	CACHE_LIMIT_BYTES = 1024 * 1024 * 1024  # 1 GiB — Achado v2-8: API moderna, não mx.metal.*
    41	LLM_MODEL_ID = "mlx-community/Qwen3-4B-Instruct-2507-4bit"
    42	STT_MODEL_ID = "mlx-community/whisper-small-mlx"
    43	MAX_TURN_TOKENS = 160
    44	
    45	
    46	def log_diag(message: str) -> None:
    47	    """Diagnóstico técnico em stderr — nunca inclui transcrição ou conteúdo de conversa."""
    48	    print(f"[worker] {message}", file=sys.stderr, flush=True)
    49	
    50	
    51	def emit(event: dict[str, Any]) -> None:
    52	    """Único ponto de escrita em stdout — protocolo NDJSON."""
    53	    sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    54	    sys.stdout.flush()
    55	
    56	
    57	# --- Segmentador de frases PT-BR (Achado v2-3: não fragmentar decimais/abreviações) ---
    58	
    59	_ABBREVIATIONS = {
    60	    "sr", "sra", "srta", "dr", "dra", "prof", "profa", "ex", "etc",
    61	    "ltda", "vs", "pág", "p", "ed", "nº", "art", "cap"
    62	}
