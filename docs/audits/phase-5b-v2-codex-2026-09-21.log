    51	        const raw = Buffer.concat(chunks).toString('utf-8');
    52	        resolve(raw.length > 0 ? JSON.parse(raw) : {});
    53	      } catch {
    54	        reject(new Error('JSON inválido.'));
    55	      }
    56	    });
    57	    req.on('error', reject);
    58	  });
