   396	/**
   397	 * Pré-filtro (§4.1). Permissivo DE PROPÓSITO: decide apenas se vale perguntar ao modelo,
   398	 * nunca qual ferramenta usar. Falso positivo custa uma inferência; falso negativo custa a
   399	 * funcionalidade.
   400	 */
   401	const TIME_GATE =
   402	  /\b(hora|horas|horario|que dia|dia de hoje|data|hoje|agora|amanha|ontem|semana|mes|ano)\b/;
   403	
   404	export function mightBeTemporal(transcript: string): boolean {
   405	  const normalized = transcript
   406	    .toLowerCase()
   407	    .normalize('NFD')
   408	    .replace(/[̀-ͯ]/g, '');
   409	  return TIME_GATE.test(normalized);
   410	}
   411	
   412	export function buildToolBlock(fact: string): string {
   413	  return (
   414	    `Fato apurado do sistema neste instante: ${fact}. ` +
   415	    'Use este dado como verdadeiro e não o contradiga; ele vem do relógio do computador, não do ' +
   416	    'seu conhecimento. Responda de forma natural e falada, sem ler este aviso em voz alta.'
   417	  );
   418	}
   419	
   420	/** Falha fechada (§4.4): detectada a intenção, a invenção não volta. */
   421	export function buildToolFailureBlock(): string {
   422	  return (
   423	    'O relógio do sistema não pôde ser consultado neste instante. NÃO invente nem estime a hora ' +
   424	    'ou a data. Diga ao usuário, de forma breve e natural, que não conseguiu consultar o relógio ' +
   425	    'agora.'
   426	  );
   427	}
