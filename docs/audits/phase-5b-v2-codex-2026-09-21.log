   176	# --- Estado de geração cancelável ---
   177	
   178	@dataclass
   179	class GenerationHandle:
   180	    turn_id: str
   181	    epoch: int
   182	    cancel_event: threading.Event = field(default_factory=threading.Event)
   183	
   184	
   185	class Worker:
   186	    def __init__(self) -> None:
   187	        self.work_queue: "queue.Queue[dict[str, Any]]" = queue.Queue(maxsize=1)
   188	        self._current: Optional[GenerationHandle] = None
   189	        self._current_lock = threading.Lock()
   190	        self._llm = None
   191	        self._llm_tokenizer = None
   192	        self._stt = None
   193	        self._mx = None
   194	
   195	    # --- Carregamento de modelos (warmup) ---
   196	
   197	    def load_models(self) -> None:
   198	        import mlx.core as mx
   199	
   200	        self._mx = mx
   201	        mx.set_cache_limit(CACHE_LIMIT_BYTES)
   202	
   203	        log_diag(f"Carregando LLM ({LLM_MODEL_ID})...")
   204	        from mlx_lm import load as mlx_lm_load
   205	
   206	        self._llm, self._llm_tokenizer = mlx_lm_load(LLM_MODEL_ID)
   207	        log_diag("LLM carregado.")
   208	
   209	        log_diag(f"Carregando STT ({STT_MODEL_ID})...")
   210	        # mlx_whisper carrega o modelo sob demanda por chamada de transcribe(path_or_hf_repo=...);
   211	        # fazemos uma chamada de aquecimento silenciosa não é viável sem áudio real, então
   212	        # apenas confirmamos que o pacote importa e o repo é resolvível localmente.
   213	        import mlx_whisper  # noqa: F401
   214	
   215	        self._stt_model_id = STT_MODEL_ID
   216	        log_diag("STT pronto (carregamento perezoso na primeira transcrição).")
   217	
   218	        mx.clear_cache()
   219	        emit({"event": "ready"})
   220	
   221	    # --- Comandos ---
   222	
   223	    def handle_cancel(self, msg: dict[str, Any]) -> None:
   224	        turn_id = msg.get("turnId")
   225	        with self._current_lock:
   226	            current = self._current
   227	            if current is not None and current.turn_id == turn_id:
   228	                current.cancel_event.set()
   229	        emit({"event": "cancelled", "turnId": turn_id})
   230	
   231	    def handle_transcribe(self, msg: dict[str, Any]) -> None:
   232	        req_id = msg["reqId"]
   233	        audio_path = msg["audioPath"]
   234	        try:
   235	            import mlx_whisper
   236	
   237	            result = mlx_whisper.transcribe(
   238	                audio_path,
   239	                path_or_hf_repo=self._stt_model_id,
   240	                language="pt",
   241	                fp16=True,
   242	            )
   243	            text = (result.get("text") or "").strip()
   244	            emit({"event": "transcript", "reqId": req_id, "text": text})
   245	        except Exception as exc:  # noqa: BLE001
   246	            log_diag(f"Erro na transcrição: {exc}\n{traceback.format_exc()}")
   247	            emit({"event": "error", "reqId": req_id, "message": "Falha ao transcrever áudio."})
   248	        finally:
   249	            if self._mx is not None:
   250	                self._mx.clear_cache()
   251	
   252	    def handle_classify(self, msg: dict[str, Any]) -> None:
   253	        req_id = msg["reqId"]
   254	        turn_id = msg["turnId"]
   255	        epoch = msg["epoch"]
   256	        text = msg["text"]
   257	
   258	        # Achado v2-1 da auditoria: texto vazio/só espaço nunca vai pro LLM — o STT pode
   259	        # devolver "" para ruído/fala inaudível que passou pelo VAD; sem essa checagem o
   260	        # resultado da classificação fica imprevisível em vez de ser um erro técnico claro.
   261	        if not text or not text.strip():
   262	            emit({
   263	                "event": "error", "reqId": req_id, "turnId": turn_id,
   264	                "message": "Texto vazio para classificação."
   265	            })
   266	            return
   267	
   268	        handle = GenerationHandle(turn_id=turn_id, epoch=epoch)
   269	        with self._current_lock:
   270	            self._current = handle
   271	
   272	        try:
   273	            messages = [
   274	                {"role": "system", "content": CLASSIFICATION_SYSTEM_PROMPT},
   275	                {"role": "user", "content": text},
   276	            ]
   277	            prompt = self._llm_tokenizer.apply_chat_template(
   278	                messages, add_generation_prompt=True, tokenize=False
   279	            )
   280	
   281	            from mlx_lm.generate import stream_generate
   282	            from mlx_lm.sample_utils import make_sampler
   283	
   284	            sampler = make_sampler(temp=0.0)  # determinístico — classificação, não geração criativa
   285	            raw = ""
   286	            for response in stream_generate(
   287	                self._llm, self._llm_tokenizer, prompt, max_tokens=8, sampler=sampler
   288	            ):
   289	                if handle.cancel_event.is_set():
   290	                    log_diag(f"Classificação cancelada pelo worker (turnId={turn_id}) — Node já resolveu localmente.")
   291	                    return
   292	                raw += response.text
   293	
   294	            normalized = raw.strip().upper().strip(".!? \n")
   295	            if normalized not in CLASSIFICATION_LABELS:
   296	                log_diag(f"Saída de classificação fora do formato esperado (turnId={turn_id}).")
   297	                emit({
   298	                    "event": "error", "reqId": req_id, "turnId": turn_id,
   299	                    "message": "Falha ao classificar: formato de saída inesperado."
   300	                })
   301	                return
   302	
   303	            emit({"event": "classification", "reqId": req_id, "turnId": turn_id, "label": normalized})
   304	        except Exception as exc:  # noqa: BLE001
   305	            log_diag(f"Erro na classificação: {exc}\n{traceback.format_exc()}")
   306	            emit({"event": "error", "reqId": req_id, "turnId": turn_id, "message": "Falha ao classificar a intenção."})
   307	        finally:
   308	            with self._current_lock:
   309	                if self._current is handle:
   310	                    self._current = None
   311	            if self._mx is not None:
   312	                self._mx.clear_cache()
   313	
   314	    def handle_generate(self, msg: dict[str, Any]) -> None:
   315	        req_id = msg["reqId"]
   316	        turn_id = msg["turnId"]
   317	        epoch = msg["epoch"]
   318	        messages = msg["messages"]
   319	
   320	        handle = GenerationHandle(turn_id=turn_id, epoch=epoch)
   321	        with self._current_lock:
   322	            self._current = handle
   323	
   324	        try:
   325	            prompt = self._llm_tokenizer.apply_chat_template(
   326	                messages, add_generation_prompt=True, tokenize=False
   327	            )
   328	
   329	            from mlx_lm.generate import stream_generate
   330	            from mlx_lm.sample_utils import make_logits_processors, make_sampler
   331	
   332	            sampler = make_sampler(temp=0.7)
   333	            # Achado real de teste (Fase 4, verificação com áudio real): sem penalidade de
   334	            # repetição, o Qwen3-4B-Instruct-2507-4bit entra em loop, repetindo a mesma
   335	            # frase dezenas de vezes antes de variar — mais visível em respostas longas e
   336	            # discursivas (Teologia/Virtologia) do que nas perguntas curtas usadas nos
   337	            # benchmarks das Fases 2-3, que não expunham o problema. `repetition_context_size`
   338	            # igual a MAX_TURN_TOKENS (não o padrão de 20) porque uma frase repetida some da
   339	            # janela de contexto do penalizador antes do fim do turno se a janela for menor
   340	            # que a resposta inteira — testado com 64: o loop reaparecia depois de ~2
   341	            # repetições, exatamente quando a 1ª ocorrência saía da janela.
   342	            logits_processors = make_logits_processors(
   343	                repetition_penalty=1.3, repetition_context_size=MAX_TURN_TOKENS
   344	            )
   345	            buffer = ""
   346	            sentence_index = 0
   347	            token_count = 0
   348	            emitted_normalized: list[str] = []  # histórico de frases deste turno p/ detecção
   349	            loop_detected = False
   350	
   351	            for response in stream_generate(
   352	                self._llm,
   353	                self._llm_tokenizer,
   354	                prompt,
   355	                max_tokens=MAX_TURN_TOKENS,
   356	                sampler=sampler,
   357	                logits_processors=logits_processors,
   358	            ):
   359	                if handle.cancel_event.is_set():
   360	                    log_diag(f"Geração cancelada (turnId={turn_id}) — descartando sem mx.eval().")
   361	                    break
   362	
   363	                buffer += response.text
   364	                token_count += 1
   365	
   366	                boundary = find_sentence_boundary(buffer)
   367	                while boundary is not None:
   368	                    sentence = buffer[:boundary].strip()
   369	                    buffer = buffer[boundary:]
   370	                    if sentence:
   371	                        # Correção do loop de repetição (achado fora do escopo da Fase 4, ver
   372	                        # docs/implementation-phase-4.md e docs/fix-generation-repetition-loop-v2.md):
   373	                        # trata uma frase quase-duplicada como fim natural da resposta, não como erro.
   374	                        if _is_near_duplicate_sentence(sentence, emitted_normalized):
   375	                            log_diag(
   376	                                f"Loop de repetição detectado (turnId={turn_id}, "
   377	                                f"frase {sentence_index}) — encerrando geração aqui."
   378	                            )
   379	                            loop_detected = True
   380	                            break
   381	                        emit({
   382	                            "event": "sentence",
   383	                            "reqId": req_id,
   384	                            "turnId": turn_id,
   385	                            "index": sentence_index,
   386	                            "text": sentence,
   387	                        })
   388	                        emitted_normalized.append(_normalize_for_dedup(sentence))
   389	                        sentence_index += 1
   390	                    boundary = find_sentence_boundary(buffer)
   391	
   392	                if loop_detected:
   393	                    break
   394	
   395	                if token_count >= MAX_TURN_TOKENS:
   396	                    break
   397	
   398	            if not handle.cancel_event.is_set():
   399	                # O residual também passa pela detecção — sem isso, um corte por
   400	                # MAX_TURN_TOKENS no meio de uma repetição vazaria a frase duplicada pela
   401	                # porta dos fundos, contornando a checagem acima.
   402	                if not loop_detected:
   403	                    leftover = buffer.strip()
   404	                    if leftover and not _is_near_duplicate_sentence(leftover, emitted_normalized):
   405	                        emit({
   406	                            "event": "sentence",
   407	                            "reqId": req_id,
   408	                            "turnId": turn_id,
   409	                            "index": sentence_index,
   410	                            "text": leftover,
   411	                        })
   412	                emit({"event": "done", "reqId": req_id, "turnId": turn_id})
   413	        except Exception as exc:  # noqa: BLE001
   414	            log_diag(f"Erro na geração: {exc}\n{traceback.format_exc()}")
   415	            emit({"event": "error", "reqId": req_id, "turnId": turn_id, "message": "Falha ao gerar resposta."})
   416	        finally:
   417	            with self._current_lock:
   418	                if self._current is handle:
   419	                    self._current = None
   420	            # Ponto crítico (Refinamento 2 do adendo): limpar cache sem forçar mx.eval()
   421	            # nos tensores pendentes do turno cancelado.
   422	            if self._mx is not None:
   423	                self._mx.clear_cache()
   424	
   425	    # --- Loop de trabalho (thread principal) ---
   426	
   427	    def work_loop(self) -> None:
   428	        while True:
   429	            msg = self.work_queue.get()
   430	            cmd = msg.get("cmd")
   431	            try:
   432	                if cmd == "transcribe":
   433	                    self.handle_transcribe(msg)
   434	                elif cmd == "classify":
   435	                    self.handle_classify(msg)
   436	                elif cmd == "generate":
   437	                    self.handle_generate(msg)
   438	            except Exception as exc:  # noqa: BLE001
   439	                log_diag(f"Erro não tratado no work_loop: {exc}\n{traceback.format_exc()}")
   440	                emit({"event": "error", "message": "Falha interna do worker."})
   441	
   442	    # --- Thread leitora de stdin (dedicada, nunca bloqueia em inferência) ---
   443	
   444	    def stdin_reader_loop(self) -> None:
   445	        for line in sys.stdin:
   446	            line = line.strip()
   447	            if not line:
   448	                continue
   449	            try:
   450	                msg = json.loads(line)
   451	            except json.JSONDecodeError:
   452	                log_diag("Linha stdin inválida (não é JSON) — ignorada.")
   453	                continue
   454	
   455	            cmd = msg.get("cmd")
   456	            if cmd == "cancel":
   457	                self.handle_cancel(msg)
   458	            elif cmd == "ping":
   459	                emit({"event": "pong"})
   460	            elif cmd in ("transcribe", "classify", "generate"):
   461	                # Fila de tamanho 1: se algo estiver esperando (não deveria, pois o Node só
   462	                # envia um novo comando após cancelar o anterior), descarta o mais antigo.
   463	                try:
   464	                    self.work_queue.put_nowait(msg)
   465	                except queue.Full:
   466	                    try:
   467	                        self.work_queue.get_nowait()
   468	                    except queue.Empty:
   469	                        pass
   470	                    self.work_queue.put_nowait(msg)
   471	            else:
   472	                log_diag(f"Comando desconhecido ignorado: {cmd!r}")
   473	
   474	        # stdin fechado (Node encerrou) — sai limpo.
   475	        log_diag("stdin fechado — encerrando worker.")
   476	        os._exit(0)
   477	
   478	
   479	def main() -> None:
   480	    worker = Worker()
   481	
   482	    reader_thread = threading.Thread(target=worker.stdin_reader_loop, daemon=True)
   483	    reader_thread.start()
   484	
   485	    start = time.monotonic()
   486	    try:
   487	        worker.load_models()
   488	    except Exception as exc:  # noqa: BLE001
   489	        log_diag(f"Falha catastrófica ao carregar modelos: {exc}\n{traceback.format_exc()}")
   490	        emit({"event": "error", "message": "Falha ao inicializar modelos locais."})
