   327	      }
   328	    } catch (err) {
   329	      if (session.activeTurn === turn) {
   330	        this.emit(session, {
   331	          type: 'error',
   332	          turnId: turn.turnId,
   333	          message: err instanceof Error ? err.message : 'Erro desconhecido.'
   334	        });
