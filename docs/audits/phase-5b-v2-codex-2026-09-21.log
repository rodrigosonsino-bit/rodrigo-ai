   336	        session.activeTurn = null;
   337	      }
   338	    }
   339	  }
   340	
   341	  private async synthesizeSentence(session: Session, turn: ActiveTurn, text: string, index: number): Promise<void> {
   342	    const { audioId, filePath } = this.audioStore.newOutputPath(session.id);
   343	    try {
   344	      await this.ttsProvider.synthesize(text, filePath, turn.abortController.signal);
