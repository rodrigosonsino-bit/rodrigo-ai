    71	
    72	def emit(event: dict[str, Any]) -> None:
    73	    """Único ponto de escrita em stdout — protocolo NDJSON."""
    74	    sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    75	    sys.stdout.flush()
