    66	    req.on('data', (chunk: Buffer) => {
    67	      if (rejected) return; // já rejeitado: continua drenando o socket sem acumular mais nada
    68	      total += chunk.length;
    69	      if (total > maxBytes) {
    70	        rejected = true;
    71	        // Não destruir o socket aqui — o cliente ainda está no meio do envio; destruir agora
    72	        // mata a conexão antes que o 413 seja escrito, e o cliente só vê "socket closed".
