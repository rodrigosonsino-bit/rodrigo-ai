     9	/**
    10	 * Motor de voz fake, determinístico, sem MLX/Python — usado em testes (B4/B5, e Fase 3
    11	 * C5) para validar sessão, cancelamento, preempção e turnId sem depender do runtime pesado.
    12	 */
    13	export class FakeVoiceEngine implements VoiceEngine {
    14	  public transcribeCalls: string[] = [];
    15	  public generateCalls: Array<{ turnId: string; epoch: number; messages: ConversationMessage[] }> = [];
    16	  public classifyCalls: Array<{ turnId: string; text: string }> = [];
    17	  public cancelledTurnIds: string[] = [];
    18	  public shutdownCalled = false;
    19	
    20	  private cancelledSet = new Set<string>();
    21	  public fixedTranscript = 'olá rodrigo';
    22	  public sentencesToEmit = ['Olá!', 'Como posso ajudar?'];
    23	  /** Atraso simulado (ms) entre frases, para testes de cancelamento no meio da geração. */
    24	  public sentenceDelayMs = 0;
    25	
    26	  public classificationToReturn: OrchestratorLabel = 'GERAL';
    27	  /**
    28	   * Se 0 (padrão), classify() resolve no mesmo tick. Se > 0, fica pendente até esse
    29	   * tempo OU até releaseClassifyGate(turnId)/cancel(turnId) liberar manualmente — usado
    30	   * pelos testes que precisam provar cancelamento real (Achado 5 da auditoria: um fake
    31	   * que só espera e retorna não prova nada sobre limpeza de pending/timer).
    32	   */
    33	  public classifySettleDelayMs = 0;
    34	  private classifyGates = new Map<string, ClassifyGate>();
    35	
    36	  isReadySync(): boolean {
    37	    return true;
    38	  }
    39	
    40	  async waitUntilReady(): Promise<void> {
    41	    return;
    42	  }
    43	
    44	  async transcribe(audioPath: string): Promise<string> {
    45	    this.transcribeCalls.push(audioPath);
    46	    return this.fixedTranscript;
    47	  }
    48	
    49	  async classify(turnId: string, epoch: number, text: string): Promise<OrchestratorLabel> {
    50	    this.classifyCalls.push({ turnId, text });
    51	
    52	    await new Promise<void>((resolve) => {
    53	      let timer: NodeJS.Timeout | null = null;
    54	      if (this.classifySettleDelayMs > 0) {
    55	        timer = setTimeout(resolve, this.classifySettleDelayMs);
    56	      }
    57	      this.classifyGates.set(turnId, { resolve, timer });
    58	      if (this.classifySettleDelayMs === 0) resolve();
    59	    });
    60	
    61	    this.classifyGates.delete(turnId);
    62	    if (this.cancelledSet.has(turnId)) {
    63	      throw new Error(`Classificação do turno ${turnId} cancelada.`);
    64	    }
    65	    return this.classificationToReturn;
    66	  }
    67	
    68	  /** Libera manualmente uma classificação travada em classifySettleDelayMs alto (sem cancelar). */
    69	  releaseClassifyGate(turnId: string): void {
    70	    const gate = this.classifyGates.get(turnId);
    71	    if (!gate) return;
    72	    if (gate.timer) clearTimeout(gate.timer);
    73	    this.classifyGates.delete(turnId);
    74	    gate.resolve();
    75	  }
    76	
    77	  isClassifyPending(turnId: string): boolean {
    78	    return this.classifyGates.has(turnId);
    79	  }
    80	
    81	  async generate(
    82	    turnId: string,
    83	    epoch: number,
    84	    messages: ConversationMessage[],
    85	    callbacks: GenerateCallbacks
    86	  ): Promise<void> {
    87	    this.generateCalls.push({ turnId, epoch, messages });
    88	
    89	    for (let i = 0; i < this.sentencesToEmit.length; i += 1) {
    90	      if (this.cancelledSet.has(turnId)) {
    91	        return;
    92	      }
    93	      if (this.sentenceDelayMs > 0) {
    94	        await new Promise((resolve) => setTimeout(resolve, this.sentenceDelayMs));
    95	      }
    96	      if (this.cancelledSet.has(turnId)) {
    97	        return;
    98	      }
    99	      callbacks.onSentence(this.sentencesToEmit[i], i);
   100	    }
   101	  }
   102	
   103	  cancel(turnId: string): void {
   104	    this.cancelledSet.add(turnId);
   105	    this.cancelledTurnIds.push(turnId);
   106	
   107	    // Achado v2-3 da auditoria: limpar o timer do gate (não só resolvê-lo) — sem isso,
   108	    // um classifySettleDelayMs alto deixa um setTimeout vazando no runner de testes.
   109	    const gate = this.classifyGates.get(turnId);
   110	    if (gate) {
   111	      if (gate.timer) clearTimeout(gate.timer);
   112	      this.classifyGates.delete(turnId);
   113	      gate.resolve();
   114	    }
   115	  }
   116	
   117	  async shutdown(): Promise<void> {
   118	    this.shutdownCalled = true;
   119	  }
   120	}
