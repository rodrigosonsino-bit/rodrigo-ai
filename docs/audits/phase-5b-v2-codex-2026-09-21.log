   267	def parse_tool_output(raw: str) -> str:
   268	    """Função PURA — testada por scripts/worker/test_classification_parser.py.
   269	
   270	    Formato inválido degrada para NENHUMA: não reconhecer intenção de ferramenta deve custar
   271	    a ferramenta, nunca o turno (ao contrário do classificador, onde formato inválido é erro).
   272	    """
   273	    normalized = (raw or "").strip().upper().strip(".!? \n")
   274	    return normalized if normalized in TOOL_NAMES else "NENHUMA"
   275	
   276	
   277	    def handle_detect_tool(self, msg: dict[str, Any]) -> None:
   278	        req_id = msg["reqId"]
   279	        turn_id = msg["turnId"]
   280	        epoch = msg["epoch"]
   281	        text = msg["text"]
   282	
   283	        if not text or not text.strip():
   284	            emit({"event": "tool_detection", "reqId": req_id, "turnId": turn_id, "tool": "NENHUMA"})
   285	            return
   286	
   287	        handle = GenerationHandle(turn_id=turn_id, epoch=epoch)
   288	        with self._current_lock:
   289	            self._current = handle
   290	        try:
   291	            messages = [
   292	                {"role": "system", "content": DETECT_TOOL_SYSTEM_PROMPT},
   293	                {"role": "user", "content": text},
   294	            ]
   295	            prompt = self._llm_tokenizer.apply_chat_template(
   296	                messages, add_generation_prompt=True, tokenize=False
   297	            )
   298	            from mlx_lm.generate import stream_generate
   299	            from mlx_lm.sample_utils import make_sampler
   300	
   301	            sampler = make_sampler(temp=0.0)
   302	            raw = ""
   303	            for response in stream_generate(
   304	                self._llm, self._llm_tokenizer, prompt, max_tokens=6, sampler=sampler
   305	            ):
   306	                if handle.cancel_event.is_set():
   307	                    log_diag(f"Detecção de ferramenta cancelada (turnId={turn_id}).")
   308	                    return
   309	                raw += response.text
   310	            tool = parse_tool_output(raw)
   311	            if tool == "NENHUMA" and raw.strip():
   312	                log_diag(f"Saída de detecção fora do conjunto ({raw.strip()!r}) — degradando para NENHUMA.")
   313	            emit({"event": "tool_detection", "reqId": req_id, "turnId": turn_id, "tool": tool})
   314	        except Exception as exc:  # noqa: BLE001
   315	            log_diag(f"Erro na detecção de ferramenta: {exc}\n{traceback.format_exc()}")
   316	            emit({"event": "tool_detection", "reqId": req_id, "turnId": turn_id, "tool": "NENHUMA"})
   317	        finally:
   318	            with self._current_lock:
   319	                if self._current is handle:
   320	                    self._current = None
   321	            if self._mx is not None:
   322	                self._mx.clear_cache()
   323	```
