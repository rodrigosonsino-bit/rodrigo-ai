    74	        reject(new Error('Áudio excede o limite de tamanho permitido (2 MB).'));
    75	        return;
    76	      }
    77	      chunks.push(chunk);
    78	    });
    79	    req.on('end', () => {
    80	      if (!rejected) resolve(Buffer.concat(chunks));
    81	    });
    82	    req.on('error', reject);
    83	  });
    84	}
