    20	/**
    21	 * Monta o runtime de voz se — e só se — o setup local (`npm run setup:voice`) já rodou.
    22	 * Ausência de qualquer peça (venv, worker script, modelos) é diagnosticada honestamente
    23	 * em PT-BR; a base da Fase 1 continua funcionando sem depender de Python (B2).
    24	 */
    25	export function createVoiceRuntime(rootDir: string): VoiceRuntime {
    26	  // Usado pela suíte de testes automatizada: garante que `npm test` nunca depende de
    27	  // Python/MLX estarem instalados ou aquecidos, mesmo que .runtime já exista na máquina
    28	  // de quem está rodando os testes (B2: "retorno à base não depende de Python").
    29	  if (process.env.RODRIGO_VOICE_DISABLE === '1') {
    30	    return {
    31	      available: false,
    32	      reason: 'Voz desabilitada explicitamente (RODRIGO_VOICE_DISABLE=1).',
    33	      shutdown: async () => {}
    34	    };
    35	  }
    36	
    37	  const venvPython = path.join(rootDir, '.runtime', '.venv', 'bin', 'python3');
    38	  const workerScript = path.join(rootDir, 'scripts', 'worker', 'worker.py');
    39	  const manifestPath = path.join(rootDir, '.runtime', 'models-manifest.json');
    40	  const hfCacheDir = path.join(rootDir, '.runtime', 'hf-cache');
    41	
    42	  if (!fs.existsSync(venvPython)) {
    43	    return {
    44	      available: false,
    45	      reason: 'Runtime de voz não configurado: rode "npm run setup:voice" primeiro (cria o ambiente Python local e baixa os modelos).',
    46	      shutdown: async () => {}
    47	    };
    48	  }
    49	  if (!fs.existsSync(workerScript)) {
    50	    return {
    51	      available: false,
    52	      reason: `Worker de voz não encontrado em ${workerScript}.`,
    53	      shutdown: async () => {}
    54	    };
    55	  }
    56	  if (!fs.existsSync(manifestPath)) {
    57	    return {
    58	      available: false,
    59	      reason: 'Modelos de voz não baixados: rode "npm run setup:voice" para materializá-los localmente.',
    60	      shutdown: async () => {}
    61	    };
    62	  }
    63	
    64	  const engine = new MlxWorkerEngine({ pythonBin: venvPython, workerScript, hfCacheDir });
    65	  const ttsProvider = selectVoiceProvider();
    66	  ExtensionRegistry.getInstance().registerVoiceProvider(ttsProvider);
    67	
    68	  const agents = createSpecialistAgents();
    69	  for (const agent of agents) {
    70	    ExtensionRegistry.getInstance().registerAgent(agent);
    71	  }
    72	
    73	  // Fase 5a: o corpus é carregado SOMENTE neste caminho — ou seja, só quando a voz está de fato
    74	  // disponível. Mesma regra de honestidade que a Fase 4 aplica ao registro dos agentes: nada é
    75	  // reportado como disponível antes de existir.
    76	  const knowledgeChunks = loadKnowledgeCorpus(rootDir);
    77	  const retriever = knowledgeChunks.length > 0 ? new KnowledgeRetriever(knowledgeChunks) : null;
    78	  ExtensionRegistry.getInstance().registerKnowledge(knowledgeChunks.length);
    79	
    80	  const audioStore = new AudioStore(path.join(rootDir, '.runtime', 'tmp'));
    81	  const sessionManager = new SessionManager(engine, ttsProvider, audioStore, agents, retriever);
    82	
    83	  return {
    84	    available: true,
    85	    sessionManager,
    86	    audioStore,
    87	    shutdown: async () => {
    88	      await sessionManager.shutdownAll();
    89	      await engine.shutdown();
    90	    }
    91	  };
    92	}
