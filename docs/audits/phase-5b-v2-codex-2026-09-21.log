    51	/**
    52	 * Motor de voz real: worker Python persistente (MLX LM + MLX Whisper) falado via
    53	 * NDJSON em stdin/stdout. Reinício do processo é reservado a falhas catastróficas
    54	 * (crash, timeout de turno, protocolo corrompido) — nunca por cancelamento normal de
    55	 * barge-in, que é tratado via comando "cancel" cooperativo E resolvido localmente no
    56	 * Node sem esperar confirmação do worker (Fase 3, correção dos Achados 1+2 da auditoria:
    57	 * o Node nunca fica preso esperando uma resposta que pode nunca chegar).
    58	 */
    59	export class MlxWorkerEngine implements VoiceEngine {
    60	  private readonly options: MlxWorkerEngineOptions;
    61	  private child: ChildProcessWithoutNullStreams | null = null;
    62	  private pending = new Map<string, Pending>();
    63	  private readyResolvers: Array<() => void> = [];
    64	  private readyRejecters: Array<(err: Error) => void> = [];
    65	  private isReady = false;
    66	  private shuttingDown = false;
    67	  private restartCount = 0;
    68	  /** Incrementado a cada (re)spawn — impede que um timeout de uma instância antiga do
    69	   * worker mate uma instância nova já em uso (spawnWorker() roda no construtor e de
    70	   * novo, recursivamente, no handler de 'exit'). */
    71	  private spawnGeneration = 0;
    72	
    73	  constructor(options: MlxWorkerEngineOptions) {
    74	    this.options = options;
    75	    this.spawnWorker();
    76	  }
    77	
    78	  private spawnWorker(): void {
    79	    this.spawnGeneration += 1;
    80	    fs.mkdirSync(this.options.hfCacheDir, { recursive: true });
    81	
    82	    const child = spawn(this.options.pythonBin, [this.options.workerScript], {
    83	      stdio: ['pipe', 'pipe', 'pipe'],
    84	      shell: false,
    85	      env: {
    86	        ...process.env,
    87	        ...this.options.env,
    88	        HF_HOME: this.options.hfCacheDir,
    89	        HF_HUB_OFFLINE: '1',
    90	        TRANSFORMERS_OFFLINE: '1'
    91	      }
    92	    });
    93	    this.child = child;
    94	    this.isReady = false;
    95	
    96	    const rl = readline.createInterface({ input: child.stdout });
    97	    rl.on('line', (line) => this.handleLine(line));
    98	
    99	    child.stderr.on('data', (chunk: Buffer) => {
   100	      console.error(`[voice-worker] ${chunk.toString('utf-8').trimEnd()}`);
   101	    });
   102	
   103	    child.on('exit', (code, signal) => {
   104	      const wasReady = this.isReady;
   105	      this.isReady = false;
   106	      this.child = null;
   107	
   108	      const err = new VoiceEngineError(
   109	        `Worker de voz encerrado inesperadamente (código ${code}, sinal ${signal}).`
   110	      );
   111	      this.failAllPending(err);
   112	
   113	      if (!wasReady) {
   114	        for (const reject of this.readyRejecters) reject(err);
   115	      }
   116	      this.readyResolvers = [];
   117	      this.readyRejecters = [];
   118	
   119	      if (!this.shuttingDown) {
   120	        this.restartCount += 1;
   121	        console.error(
   122	          `[voice-worker] Reiniciando worker após falha catastrófica (tentativa ${this.restartCount}).`
   123	        );
   124	        this.spawnWorker();
   125	      }
   126	    });
   127	  }
