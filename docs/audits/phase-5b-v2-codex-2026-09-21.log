   277	          retrieved = this.retriever.retrieve(agent.id, transcript);
   278	        } catch (err) {
   279	          retrieved = [];
   280	          console.error('[knowledge] recuperação falhou, seguindo sem trecho:', err);
   281	        }
   282	      }
   283	      if (retrieved.length > 0) {
   284	        console.log(
   285	          `[knowledge] turno=${turn.turnId} agente=${agent.id} ` +
