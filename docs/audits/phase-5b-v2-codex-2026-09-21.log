    57	async function synthesizeQuestionWav(text, index) {
    58	  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'rodrigo-bench-'));
    59	  const aiff = path.join(tmpDir, `q${index}.aiff`);
    60	  const wav = path.join(tmpDir, `q${index}.wav`);
    61	  await execFileAsync('/usr/bin/say', ['-v', 'Luciana', '-o', aiff, '--', text]);
    62	  await execFileAsync('ffmpeg', ['-y', '-nostdin', '-i', aiff, '-ar', '16000', '-ac', '1', wav]);
    63	  return wav;
    64	}
    65	
    66	function readSse(url) {
    67	  const events = [];
    68	  const controller = new AbortController();
    69	
    70	  const promise = fetch(url, { signal: controller.signal }).then(async (res) => {
    71	    const reader = res.body.getReader();
    72	    const decoder = new TextDecoder();
    73	    let buffer = '';
    74	    // eslint-disable-next-line no-constant-condition
    75	    while (true) {
    76	      const { done, value } = await reader.read();
    77	      if (done) break;
    78	      buffer += decoder.decode(value, { stream: true });
    79	      const parts = buffer.split('\n\n');
    80	      buffer = parts.pop() || '';
    81	      for (const part of parts) {
    82	        const line = part.split('\n').find((l) => l.startsWith('data: '));
    83	        if (line) {
    84	          events.push({ t: performance.now(), event: JSON.parse(line.slice(6)) });
    85	        }
    86	      }
    87	    }
    88	  }).catch(() => {});
    89	
    90	  return { events, close: () => controller.abort(), promise };
    91	}
    92	
    93	function percentile(values, p) {
    94	  const sorted = [...values].sort((a, b) => a - b);
    95	  const idx = Math.ceil((p / 100) * sorted.length) - 1;
    96	  return sorted[Math.max(0, Math.min(sorted.length - 1, idx))];
    97	}
    98	
    99	async function runOneTurn(sessionId, token, wavPath, sse) {
   100	  const audioBuffer = fs.readFileSync(wavPath);
   101	  const tSent = performance.now();
   102	
   103	  const res = await fetch(`${BASE_URL}/api/voice/session/audio`, {
   104	    method: 'POST',
   105	    headers: { 'X-Rodrigo-Session': sessionId, 'X-Rodrigo-Token': token, 'Content-Type': 'audio/wav' },
   106	    body: audioBuffer
   107	  });
   108	  if (!res.ok) {
   109	    throw new Error(`Falha ao enviar áudio: ${res.status} ${await res.text()}`);
   110	  }
   111	  const { turnId } = await res.json();
   112	
   113	  const deadline = Date.now() + 30_000;
   114	  let tTranscript = null;
   115	  let tFirstAudio = null;
   116	  let tDone = null;
   117	
   118	  const startLen = sse.events.length;
   119	  while (Date.now() < deadline) {
   120	    for (let i = startLen; i < sse.events.length; i += 1) {
   121	      const { t, event } = sse.events[i];
   122	      if (event.turnId && event.turnId !== turnId) continue;
   123	      if (event.type === 'transcript' && tTranscript === null) tTranscript = t;
   124	      if (event.type === 'sentence_audio_ready' && tFirstAudio === null) tFirstAudio = t;
   125	      if (event.type === 'turn_done') tDone = t;
   126	    }
   127	    if (tDone !== null) break;
   128	    await new Promise((r) => setTimeout(r, 50));
   129	  }
   130	
   131	  if (tFirstAudio === null) {
   132	    throw new Error(`Turno ${turnId} não produziu áudio dentro do timeout de 30s.`);
   133	  }
   134	
   135	  return {
   136	    sttMs: tTranscript ? tTranscript - tSent : null,
   137	    firstAudioMs: tFirstAudio - tSent,
   138	    totalMs: (tDone || tFirstAudio) - tSent
   139	  };
   140	}
   141	
   142	async function main() {
   143	  console.log(`[bench] Conectando em ${BASE_URL} — certifique-se que "npm start" ou "npm run dev" já está rodando com o runtime de voz configurado.`);
   144	
   145	  const createRes = await fetch(`${BASE_URL}/api/voice/session`, { method: 'POST' });
   146	  if (!createRes.ok) {
   147	    console.error(`[bench] Não foi possível criar sessão (${createRes.status}). Voz local está configurada? Rode "npm run setup:voice".`);
   148	    process.exit(1);
   149	  }
   150	  const { sessionId, token } = await createRes.json();
   151	
   152	  const sse = readSse(`${BASE_URL}/api/voice/session/events?sessionId=${sessionId}&token=${token}`);
   153	  await new Promise((r) => setTimeout(r, 300));
   154	
   155	  console.log('[bench] Sintetizando perguntas de teste com "say" (entrada sintética, não é o teste humano de verdade)...');
   156	  const wavPaths = [];
   157	  for (let i = 0; i < QUESTIONS.length; i += 1) {
   158	    wavPaths.push(await synthesizeQuestionWav(QUESTIONS[i], i));
   159	  }
   160	
   161	  console.log('[bench] Aquecendo (1ª pergunta, ignorada nas métricas — pode levar até 2min)...');
   162	  await runOneTurn(sessionId, token, wavPaths[0], sse);
   163	
   164	  const results = [];
   165	  for (let i = 1; i < wavPaths.length; i += 1) {
   166	    console.log(`[bench] Turno ${i}/${wavPaths.length - 1}: "${QUESTIONS[i]}"`);
   167	    const r = await runOneTurn(sessionId, token, wavPaths[i], sse);
   168	    console.log(`  STT: ${r.sttMs?.toFixed(0) ?? 'n/d'}ms | 1º áudio: ${r.firstAudioMs.toFixed(0)}ms | total: ${r.totalMs.toFixed(0)}ms`);
   169	    results.push(r);
   170	    await new Promise((res) => setTimeout(res, 500));
   171	  }
   172	
   173	  sse.close();
   174	  await fetch(`${BASE_URL}/api/voice/session/end`, {
   175	    method: 'POST',
   176	    headers: { 'X-Rodrigo-Session': sessionId, 'X-Rodrigo-Token': token }
   177	  }).catch(() => {});
   178	
   179	  const firstAudioValues = results.map((r) => r.firstAudioMs);
   180	  const median = percentile(firstAudioValues, 50);
   181	  const p95 = percentile(firstAudioValues, 95);
   182	
   183	  const report = {
   184	    date: new Date().toISOString(),
   185	    turns: results.length,
   186	    firstAudioMedianMs: median,
   187	    firstAudioP95Ms: p95,
   188	    target: { medianMs: 4000, p95Ms: 8000 },
   189	    passed: median <= 4000 && p95 <= 8000,
   190	    raw: results
   191	  };
   192	
   193	  console.log('\n[bench] Resultado:');
   194	  console.log(`  Mediana (fim da fala -> 1º áudio): ${median.toFixed(0)}ms (meta: <=4000ms)`);
   195	  console.log(`  p95: ${p95.toFixed(0)}ms (meta: <=8000ms)`);
   196	  console.log(`  Veredito: ${report.passed ? 'DENTRO DA META' : 'FORA DA META — ver candidatas de otimização no adendo do plano'}`);
   197	
   198	  fs.mkdirSync('docs/audits', { recursive: true });
   199	  const outPath = `docs/audits/voice-benchmark-${BENCH_TAG}.json`;
   200	  fs.writeFileSync(outPath, JSON.stringify({ set: BENCH_SET, tag: BENCH_TAG, ...report }, null, 2));
   201	  console.log(`[bench] Relatório salvo em ${outPath}`);
   202	}
   203	
   204	main().catch((err) => {
   205	  console.error('[bench] Falhou:', err);
   206	  process.exit(1);
   207	});
