   391	export function selectToolByName(tool: ToolName, tools: readonly ITool[]): ITool | null {
   392	  if (tool === 'NENHUMA') return null;
   393	  return tools.find((t) => t.name === tool && t.isAvailable()) ?? null;
   394	}
