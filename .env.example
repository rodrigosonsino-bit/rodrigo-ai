# Rodrigo AI - Configurações locais
# O áudio do microfone, o STT, as notas, os lembretes e as memórias ficam neste computador.
# A geração de resposta (Fase 10a), a classificação de intenção (Fase 11) e a voz das respostas (Fase 13a)
# usam o Gemini via Google GenAI API: o TEXTO das falas e das frases faladas vai à nuvem. Veja README seção 7.
PORT=3000
HOST=127.0.0.1
CLIENT_PORT=5173

# Fase 10a — Geração de resposta via Gemini (Google GenAI API).
# Obtenha sua chave em https://aistudio.google.com/
# ATENÇÃO: no nível GRATUITO da API, o Google pode usar e revisar o conteúdo enviado (termos de 28/04/2026); veja README seção 7.
GEMINI_API_KEY=sua_chave_aqui


# Voz das respostas. Padrão "gemini" (Fase 13a): TTS do Gemini, com a voz do sistema como reserva (usada na hora quando o
# Gemini falha, a cota do dia acaba ou o canal está desligado). "say" = só a voz do macOS (~0,5s); "kokoro" = motor local
# em ~/.venvs/tts-say (~1,2s); "voxcpm" = VoxCPM2 via servidor MLX em loopback (TTS-OSS, ~http://127.0.0.1:5077).
# O Gemini só é usado com GEMINI_API_KEY, RODRIGO_CLOUD_TTS=1 e RODRIGO_SEND_HISTORY=1.
TTS_ENGINE=gemini

# TTS-OSS — VoxCPM2 (opcional). Servidor: clone leoli-dev/tts-server-voxcpm e `uv run voxcpm-server` (só 127.0.0.1).
# RODRIGO_VOXCPM_URL=http://127.0.0.1:5077
# RODRIGO_VOXCPM_CONTROL=Homem brasileiro adulto, voz calma, clara e natural, tom conversacional
# RODRIGO_VOXCPM_STEPS=7
# RODRIGO_VOXCPM_TIMEOUT_MS=8000

# Voz usada pelo TTS_ENGINE=say — qualquer voz instalada em Ajustes do Sistema >
# Acessibilidade > Conteúdo Falado (liste as disponíveis com `say -v '?'`). As vozes
# "(Enhanced)"/"(Aprimorada)" têm qualidade bem melhor que a compacta com o mesmo
# custo de latência. Padrão abaixo escolhido pelo usuário após comparar opções.
SAY_VOICE=Felipe (Enhanced)

# Fase 12 — o que pode sair para o Gemini. Valores aceitos: exatamente 0 ou 1 (qualquer outro impede a inicialização).
# Mestre: 0 desliga TODA chamada ao Gemini (geração e intenção); ferramentas locais continuam; sem fallback para outro provedor.
RODRIGO_CLOUD=1
# 0 = a classificação de intenção de pedidos de hora/data/lembretes/notas fica local (só vale com RODRIGO_CLOUD=1).
RODRIGO_CLOUD_INTENT=1
# 0 = só a fala atual vai à geração (sem histórico da conversa).
RODRIGO_SEND_HISTORY=1
# Janela do histórico enviado (inteiro de 1 a 100 turnos; padrão 30).
RODRIGO_HISTORY_TURNS=30
# Timeout de inatividade da sessão em minutos antes de encerrar (inteiro de 1 a 1440; padrão 60).
RODRIGO_IDLE_TIMEOUT_MINUTES=60
# 0 = as memórias salvas não vão no prompt.
RODRIGO_SEND_MEMORIES=1
# 1 = trechos de docs/research/ (Teologia/Virtologia) vão ao Gemini. Padrão 0: material pessoal não sai.
RODRIGO_SEND_KNOWLEDGE=0

# Fase 13a — voz em nuvem (TTS do Gemini). 0 ou 1.
# 0 = só a voz do sistema; a geração de texto segue no Gemini. Desligado automaticamente com RODRIGO_SEND_HISTORY=0.
RODRIGO_CLOUD_TTS=1
# 0 = confirmações que repetem o que você ditou (prévia de nota/lembrete/memória) ficam na voz do sistema.
# Também ficam com RODRIGO_SEND_MEMORIES=0.
RODRIGO_TTS_DICTATED=1
# Modelo e voz do TTS em nuvem (letras, números, ponto, hífen, sublinhado). Preço oficial lido em 2026-10-07 para o modelo padrão:
# US$ 6 por milhão de tokens de áudio até 31/12/2026, US$ 12 depois (~25 tokens de áudio por segundo de fala).
RODRIGO_TTS_MODEL=gemini-3.8-flash-lite-tts
RODRIGO_TTS_VOICE=Charon
# Teto de pedidos por minuto e por dia. Cota do Google no Nível 1: 10 por minuto e 100 por dia, por modelo (margem: 8 e 90).
RODRIGO_TTS_RPM=8
RODRIGO_TTS_RPD=90
# Livro-caixa do gasto próprio (GET /api/usage, seção "Uso hoje"): teto de pedidos/dia por fonte
# para a barra de %. Padrões = cotas do Nível 1 por modelo. Só exibição — não bloqueia nada.
RODRIGO_USAGE_RPD=100
RODRIGO_USAGE_RPD_TTS=90

# Fase V — imagem da tela ao Gemini. 0 ou 1. PADRÃO 0: nada da tela vai à nuvem.
# 1 só habilita o envio; cada envio ainda exige autorização explícita na fala daquele pedido. Só vale com RODRIGO_CLOUD=1.
RODRIGO_CLOUD_VISION=0

# Fase 15 — ponte OpenClaw (gateway HTTP local). Sem token a ponte não conecta (sem mock de sucesso).
# RODRIGO_OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# RODRIGO_OPENCLAW_GATEWAY_TOKEN=
# Tarefas assíncronas pendentes em data/pendingAsyncTasks.json: na subida, descartar as mais velhas que N horas (padrão 6).
RODRIGO_ASYNC_TASK_TTL_HOURS=6
# 1 = permite busca na web autônoma via OpenClaw (capacidade openclaw_web). Padrão 0: nunca sai sem ligar o canal.
# Só vale com RODRIGO_CLOUD=1 (mesmo padrão de RODRIGO_CLOUD_TTS / RODRIGO_CLOUD_VISION).
RODRIGO_WEB_SEARCH=0

# Fase 17 — Claude Code como subagente (spawna `claude -p`). Padrão 0.
# 1 = habilita delegação por voz (com confirmação falada). A ordem e os arquivos lidos podem ir à Anthropic.
# Só vale com RODRIGO_CLOUD=1. Valor diferente de 0/1 impede a inicialização.
RODRIGO_CLAUDE_CODE=0

# Autonomia direta do Orque. Padrão 0: toda mutação (lembrete/nota/memória/digitar/etc.)
# pergunta antes (SIM em duas fases). 1 = executa já, sem pergunta, falando o resultado.
# Auditoria (T4), capacidades (T3), guardas e deny-lists continuam valendo. DESKTOP_CRITICO
# (fechar apps, lixeira, repouso, bloqueio) e AUTO_CORRECAO sempre pedem SIM.
RODRIGO_AUTO_CONFIRM=0

# Automação desktop (computer-use): loop AX → plano JSON → executor local, sem SIM por passo.
# Padrão 0. Só fica efetiva com RODRIGO_DESKTOP_CONTROL=1. Valor diferente de 0/1 impede a inicialização.
# Kill switch por voz: "parar automação". Campos de senha e empty_trash/lock/sleep ficam fora do loop livre.
# Texto/AX não saem da máquina salvo pelos canais de geração/visão já configurados.
RODRIGO_AUTO_DESKTOP=0

# Camada Ogra (fase 1: estrutura). Exatamente 0 ou 1. Padrão 0: a voz segue o caminho atual.
# 1 = o texto da fala (nunca o áudio) vai ao webhook da Ogra; a resposta volta em POST /api/ogra/reply.
# Mutação (lembrete, nota, memória) continua exigindo SIM falado. Valor diferente de 0/1 impede a inicialização.
RODRIGO_OGRA=0
# Se a ida à Ogra falhar (HTTP fora de 2xx, inclusive 429 e 5xx, prazo de 20 s, erro de rede
# ou webhook ausente), 1 (padrão) segue o MESMO turno pelo caminho normal: Gemini, ou as
# ferramentas locais se RODRIGO_CLOUD=0. Uma tentativa só. 0 encerra o turno com a frase de falha.
# A Ogra não entra no plano B do Gemini (gemini-flash-latest, depois gemini-3.5-flash-lite).
# Lembrete, nota e memória nesse caminho de reserva continuam pedindo SIM falado.
# Valor diferente de 0/1 impede a inicialização.
RODRIGO_OGRA_FALLBACK=1
# Mesmo par de scripts/avisar-grok.sh. Só é lido com RODRIGO_OGRA=1. A chave não vai no argv nem no log.
# GROK_WEBHOOK_URL=
# GROK_WEBHOOK_KEY=
# Token local dos POST /api/ogra/reply e /api/ogra/tool (Authorization: Bearer). Sem ele os dois recusam.
# Não é a chave do webhook.
# RODRIGO_OGRA_CALLBACK_TOKEN=
