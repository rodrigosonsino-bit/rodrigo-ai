# Rodrigo AI - Configurações locais
# Nenhuma chave de API ou serviço de terceiros é necessário.
# O aplicativo opera 100% localmente em loopback.
PORT=3000
HOST=127.0.0.1
CLIENT_PORT=5173

# Fase 2 (voz local) — opcional, default "say" (macOS, latência mínima, ~0,5s).
# "kokoro" usa o motor já instalado em ~/.venvs/tts-say (naturalidade maior, ~1,2s).
TTS_ENGINE=say

# Voz usada pelo TTS_ENGINE=say — qualquer voz instalada em Ajustes do Sistema >
# Acessibilidade > Conteúdo Falado (liste as disponíveis com `say -v '?'`). As vozes
# "(Enhanced)"/"(Aprimorada)" têm qualidade bem melhor que a compacta com o mesmo
# custo de latência. Padrão abaixo escolhido pelo usuário após comparar opções.
SAY_VOICE=Felipe (Enhanced)
